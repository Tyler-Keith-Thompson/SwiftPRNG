{"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"The standard library’s ","type":"text"},{"code":"random(in:using:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"shuffled(using:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"randomElement(using:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"guarantee a correct distribution, but not the same answer in every release. These draws pin the","type":"text"},{"text":" ","type":"text"},{"text":"algorithm down, so a seed gives the same numbers everywhere.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var generator = Xoshiro256StarStar(seed: 42)","let unit = generator.uniform()                  \/\/ 0.08386297105988216, in [0, 1)","let delay = generator.uniform(in: 0.5 ..< 2)    \/\/ seconds","let lane = generator.integer(in: 0 ..< 4)","let dropped = generator.bernoulli(0.01)","let order = generator.shuffled([\"north\", \"south\", \"east\", \"west\"])","let pick = generator.element(in: order)        \/\/ nil only for an empty collection"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"shuffled(_:)"},{"type":"text","text":" copies any sequence into an array and shuffles it, and "},{"type":"codeVoice","code":"shuffle(_:)"},{"type":"text","text":" shuffles a"},{"type":"text","text":" "},{"type":"text","text":"mutable random-access collection in place, such as an array or a slice of one. Both use"},{"type":"text","text":" "},{"type":"text","text":"Fisher-Yates and take one integer draw per element after the first, so an empty or one-element"},{"type":"text","text":" "},{"type":"text","text":"collection takes none. "},{"type":"codeVoice","code":"element(in:)"},{"type":"text","text":" takes one integer draw, or none for an empty collection."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A bound that can’t be sampled traps, the way an out-of-range "},{"type":"codeVoice","code":"Array"},{"type":"text","text":" subscript does. To get an"},{"type":"text","text":" "},{"type":"text","text":"error instead, use the "},{"type":"codeVoice","code":"checked"},{"type":"text","text":" spellings: "},{"type":"codeVoice","code":"integer(checkedIn:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"uniform(checkedIn:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"bernoulli(checked:)"},{"type":"text","text":" all throw."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/PlatformStableDraws","interfaceLanguage":"swift"},"kind":"article","metadata":{"title":"Platform-stable draws","roleHeading":"Article","modules":[{"name":"SwiftPRNG"}],"role":"article"},"abstract":[{"text":"Uniform values, integers, coin flips, shuffles and picks that a seed fixes on every platform and","type":"text"},{"text":" ","type":"text"},{"text":"Swift release.","type":"text"}],"variants":[{"paths":["\/documentation\/swiftprng\/platformstabledraws"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"title":"Guides","generated":true,"anchor":"Guides","identifiers":["doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SeededGenerators","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SamplingDistributions","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/NonOverlappingStreams","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/UsingSeedTrees","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SearchingSeedsAcrossCores"]}],"hierarchy":{"paths":[["doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG"]]},"sections":[],"references":{"doc://SwiftPRNG/documentation/SwiftPRNG/SamplingDistributions":{"url":"\/documentation\/swiftprng\/samplingdistributions","title":"Sampling distributions","kind":"article","abstract":[{"type":"text","text":"Normal, exponential, triangular, log-normal, gamma, Poisson, geometric and weighted-choice samples"},{"type":"text","text":" "},{"type":"text","text":"that match bit for bit on every platform."}],"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SamplingDistributions","type":"topic","role":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG/UsingSeedTrees":{"url":"\/documentation\/swiftprng\/usingseedtrees","title":"Using seed trees","kind":"article","abstract":[{"type":"text","text":"A seed for every decision, derived from a path, so adding a draw in one place never moves the"},{"type":"text","text":" "},{"type":"text","text":"numbers in another."}],"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/UsingSeedTrees","type":"topic","role":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG/NonOverlappingStreams":{"url":"\/documentation\/swiftprng\/nonoverlappingstreams","title":"Streams that never overlap","kind":"article","abstract":[{"text":"One seed, many independent streams: one per thread or one per entity.","type":"text"}],"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/NonOverlappingStreams","type":"topic","role":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG/SeededGenerators":{"url":"\/documentation\/swiftprng\/seededgenerators","title":"Seeded generators","kind":"article","abstract":[{"text":"Generators that are values, driving the standard library’s randomness API.","type":"text"}],"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SeededGenerators","type":"topic","role":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG":{"title":"SwiftPRNG","kind":"symbol","type":"topic","role":"collection","abstract":[{"text":"Seeded random numbers whose seeds you can find, write down and hand to someone else.","type":"text"}],"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG","url":"\/documentation\/swiftprng"},"doc://SwiftPRNG/documentation/SwiftPRNG/SearchingSeedsAcrossCores":{"title":"Searching seeds across cores","kind":"article","type":"topic","role":"article","abstract":[{"type":"text","text":"The smallest seed a predicate accepts, found the same way on one core or many."}],"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SearchingSeedsAcrossCores","url":"\/documentation\/swiftprng\/searchingseedsacrosscores"}}}