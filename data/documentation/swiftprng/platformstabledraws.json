{"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG"]]},"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The standard library’s ","type":"text"},{"type":"codeVoice","code":"random(in:using:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"shuffled(using:)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"randomElement(using:)"},{"text":" ","type":"text"},{"text":"guarantee a correct distribution, but not the same answer in every release. These draws pin the","type":"text"},{"text":" ","type":"text"},{"text":"algorithm down, so a seed gives the same numbers everywhere.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var generator = Xoshiro256StarStar(seed: 42)","let unit = generator.uniform()                  \/\/ 0.08386297105988216, in [0, 1)","let delay = generator.uniform(in: 0.5 ..< 2)    \/\/ seconds","let lane = generator.integer(in: 0 ..< 4)","let dropped = generator.bernoulli(0.01)","let order = generator.shuffled([\"north\", \"south\", \"east\", \"west\"])","let pick = generator.element(in: order)        \/\/ nil only for an empty collection"]},{"type":"paragraph","inlineContent":[{"code":"shuffled(_:)","type":"codeVoice"},{"text":" copies any sequence into an array and shuffles it, and ","type":"text"},{"code":"shuffle(_:)","type":"codeVoice"},{"text":" shuffles a","type":"text"},{"text":" ","type":"text"},{"text":"mutable random-access collection in place, such as an array or a slice of one. Both use","type":"text"},{"text":" ","type":"text"},{"text":"Fisher-Yates and take one integer draw per element after the first, so an empty or one-element","type":"text"},{"text":" ","type":"text"},{"text":"collection takes none. ","type":"text"},{"code":"element(in:)","type":"codeVoice"},{"text":" takes one integer draw, or none for an empty collection.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A bound that can’t be sampled traps, the way an out-of-range ","type":"text"},{"code":"Array","type":"codeVoice"},{"text":" subscript does. To get an","type":"text"},{"text":" ","type":"text"},{"text":"error instead, use the ","type":"text"},{"code":"checked","type":"codeVoice"},{"text":" spellings: ","type":"text"},{"code":"integer(checkedIn:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"uniform(checkedIn:)","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"bernoulli(checked:)","type":"codeVoice"},{"text":" all throw. Their errors, ","type":"text"},{"code":"EmptyRange","type":"codeVoice"},{"text":", ","type":"text"},{"code":"InvalidInterval","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"InvalidProbability","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"are top-level types. If another module you import declares one with the same name, qualify ours","type":"text"},{"text":" ","type":"text"},{"text":"by its module: ","type":"text"},{"code":"Sampling.EmptyRange","type":"codeVoice"},{"text":".","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftprng\/platformstabledraws"]}],"abstract":[{"type":"text","text":"Uniform values, integers, coin flips, shuffles and picks that a seed fixes on every platform and"},{"type":"text","text":" "},{"type":"text","text":"Swift release."}],"metadata":{"modules":[{"name":"SwiftPRNG"}],"title":"Platform-stable draws","role":"article","roleHeading":"Article"},"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/PlatformStableDraws"},"seeAlsoSections":[{"anchor":"Guides","identifiers":["doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SeededGenerators","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SamplingDistributions","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/NonOverlappingStreams","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/UsingSeedTrees","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SearchingSeedsAcrossCores"],"title":"Guides","generated":true}],"kind":"article","references":{"doc://SwiftPRNG/documentation/SwiftPRNG/SeededGenerators":{"url":"\/documentation\/swiftprng\/seededgenerators","type":"topic","role":"article","abstract":[{"type":"text","text":"Generators that are values, driving the standard library’s randomness API."}],"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SeededGenerators","title":"Seeded generators","kind":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG/NonOverlappingStreams":{"url":"\/documentation\/swiftprng\/nonoverlappingstreams","type":"topic","role":"article","abstract":[{"text":"One seed, many independent streams: one per thread or one per entity.","type":"text"}],"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/NonOverlappingStreams","title":"Streams that never overlap","kind":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG":{"url":"\/documentation\/swiftprng","type":"topic","role":"collection","abstract":[{"type":"text","text":"Seeded random numbers whose seeds you can find, write down and hand to someone else."}],"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG","title":"SwiftPRNG","kind":"symbol"},"doc://SwiftPRNG/documentation/SwiftPRNG/SamplingDistributions":{"url":"\/documentation\/swiftprng\/samplingdistributions","type":"topic","role":"article","abstract":[{"type":"text","text":"Normal, exponential, triangular, log-normal, gamma, Poisson, geometric and weighted-choice samples"},{"type":"text","text":" "},{"type":"text","text":"that match bit for bit on every platform."}],"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SamplingDistributions","title":"Sampling distributions","kind":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG/UsingSeedTrees":{"role":"article","title":"Using seed trees","url":"\/documentation\/swiftprng\/usingseedtrees","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/UsingSeedTrees","kind":"article","abstract":[{"type":"text","text":"A seed for every decision, derived from a path, so adding a draw in one place never moves the"},{"type":"text","text":" "},{"type":"text","text":"numbers in another."}],"type":"topic"},"doc://SwiftPRNG/documentation/SwiftPRNG/SearchingSeedsAcrossCores":{"role":"article","title":"Searching seeds across cores","url":"\/documentation\/swiftprng\/searchingseedsacrosscores","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SearchingSeedsAcrossCores","kind":"article","abstract":[{"type":"text","text":"The smallest seed a predicate accepts, found the same way on one core or many."}],"type":"topic"}}}