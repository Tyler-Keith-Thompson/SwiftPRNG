{"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Uniform values, integers, coin flips, shuffles and picks that a seed fixes on every platform and"},{"type":"text","text":" "},{"type":"text","text":"Swift release."}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"text":"The standard library’s ","type":"text"},{"code":"random(in:using:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"shuffled(using:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"randomElement(using:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"guarantee a correct distribution, but not the same answer in every release. These draws pin the","type":"text"},{"text":" ","type":"text"},{"text":"algorithm down, so a seed gives the same numbers everywhere.","type":"text"}],"type":"paragraph"},{"code":["var generator = Xoshiro256StarStar(seed: 42)","let unit = generator.uniform()                  \/\/ 0.08386297105988216, in [0, 1)","let delay = generator.uniform(in: 0.5 ..< 2)    \/\/ seconds","let lane = generator.integer(in: 0 ..< 4)","let dropped = generator.bernoulli(0.01)","let order = generator.shuffled([\"north\", \"south\", \"east\", \"west\"])","let pick = generator.element(in: order)        \/\/ nil only for an empty collection"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"shuffled(_:)"},{"type":"text","text":" copies any sequence into an array and shuffles it, and "},{"type":"codeVoice","code":"shuffle(_:)"},{"type":"text","text":" shuffles a"},{"type":"text","text":" "},{"type":"text","text":"mutable random-access collection in place, such as an array or a slice of one. Both use"},{"type":"text","text":" "},{"type":"text","text":"Fisher-Yates and take one integer draw per element after the first, so an empty or one-element"},{"type":"text","text":" "},{"type":"text","text":"collection takes none. "},{"type":"codeVoice","code":"element(in:)"},{"type":"text","text":" takes one integer draw, or none for an empty collection."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A bound that can’t be sampled traps, the way an out-of-range "},{"code":"Array","type":"codeVoice"},{"type":"text","text":" subscript does. To get an"},{"type":"text","text":" "},{"type":"text","text":"error instead, use the "},{"code":"checked","type":"codeVoice"},{"type":"text","text":" spellings: "},{"code":"integer(checkedIn:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"uniform(checkedIn:)","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"bernoulli(checked:)","type":"codeVoice"},{"type":"text","text":" all throw. Their errors, "},{"code":"EmptyRange","type":"codeVoice"},{"type":"text","text":", "},{"code":"InvalidInterval","type":"codeVoice"},{"type":"text","text":" and "},{"code":"InvalidProbability","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"are top-level types. If another module you import declares one with the same name, qualify ours"},{"type":"text","text":" "},{"type":"text","text":"by its module: "},{"code":"Sampling.EmptyRange","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/PlatformStableDraws","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftprng\/platformstabledraws"]}],"hierarchy":{"paths":[["doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG"]]},"kind":"article","seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SeededGenerators","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SamplingDistributions","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/NonOverlappingStreams","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/UsingSeedTrees","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SearchingSeedsAcrossCores"],"anchor":"Guides","title":"Guides"}],"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"SwiftPRNG"}],"title":"Platform-stable draws"},"sections":[],"references":{"doc://SwiftPRNG/documentation/SwiftPRNG/SearchingSeedsAcrossCores":{"title":"Searching seeds across cores","abstract":[{"text":"The smallest seed a predicate accepts, found the same way on one core or many.","type":"text"}],"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SearchingSeedsAcrossCores","url":"\/documentation\/swiftprng\/searchingseedsacrosscores","kind":"article","type":"topic","role":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG/SamplingDistributions":{"title":"Sampling distributions","kind":"article","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SamplingDistributions","url":"\/documentation\/swiftprng\/samplingdistributions","abstract":[{"type":"text","text":"Normal, exponential, triangular, log-normal, gamma, Poisson, geometric and weighted-choice samples"},{"type":"text","text":" "},{"type":"text","text":"that match bit for bit on every platform."}],"type":"topic","role":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG/SeededGenerators":{"title":"Seeded generators","abstract":[{"type":"text","text":"Generators that are values, driving the standard library’s randomness API."}],"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SeededGenerators","url":"\/documentation\/swiftprng\/seededgenerators","kind":"article","type":"topic","role":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG/NonOverlappingStreams":{"title":"Streams that never overlap","kind":"article","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/NonOverlappingStreams","url":"\/documentation\/swiftprng\/nonoverlappingstreams","abstract":[{"text":"One seed, many independent streams: one per thread or one per entity.","type":"text"}],"type":"topic","role":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG/UsingSeedTrees":{"title":"Using seed trees","kind":"article","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/UsingSeedTrees","url":"\/documentation\/swiftprng\/usingseedtrees","abstract":[{"type":"text","text":"A seed for every decision, derived from a path, so adding a draw in one place never moves the"},{"type":"text","text":" "},{"type":"text","text":"numbers in another."}],"type":"topic","role":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG":{"title":"SwiftPRNG","kind":"symbol","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG","url":"\/documentation\/swiftprng","abstract":[{"type":"text","text":"Seeded random numbers whose seeds you can find, write down and hand to someone else."}],"type":"topic","role":"collection"}}}