{"kind":"article","hierarchy":{"paths":[["doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG"]]},"metadata":{"role":"article","title":"Platform-stable draws","roleHeading":"Article","modules":[{"name":"SwiftPRNG"}]},"seeAlsoSections":[{"title":"Guides","generated":true,"identifiers":["doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SeededGenerators","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SamplingDistributions","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/NonOverlappingStreams","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/UsingSeedTrees","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SearchingSeedsAcrossCores"],"anchor":"Guides"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftprng\/platformstabledraws"]}],"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"inlineContent":[{"text":"The standard library’s ","type":"text"},{"code":"random(in:using:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"shuffled(using:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"randomElement(using:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"guarantee a correct distribution, but not the same answer in every release. These draws pin the","type":"text"},{"text":" ","type":"text"},{"text":"algorithm down, so a seed gives the same numbers everywhere.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var generator = Xoshiro256StarStar(seed: 42)","let unit = generator.uniform()                  \/\/ 0.08386297105988216, in [0, 1)","let delay = generator.uniform(in: 0.5 ..< 2)    \/\/ seconds","let lane = generator.integer(in: 0 ..< 4)","let dropped = generator.bernoulli(0.01)","let order = generator.shuffled([\"north\", \"south\", \"east\", \"west\"])","let pick = generator.element(in: order)        \/\/ nil only for an empty collection"]},{"inlineContent":[{"code":"shuffled(_:)","type":"codeVoice"},{"text":" copies any sequence into an array and shuffles it, and ","type":"text"},{"code":"shuffle(_:)","type":"codeVoice"},{"text":" shuffles a","type":"text"},{"text":" ","type":"text"},{"text":"mutable random-access collection in place, such as an array or a slice of one. Both use","type":"text"},{"text":" ","type":"text"},{"text":"Fisher-Yates and take one integer draw per element after the first, so an empty or one-element","type":"text"},{"text":" ","type":"text"},{"text":"collection takes none. ","type":"text"},{"code":"element(in:)","type":"codeVoice"},{"text":" takes one integer draw, or none for an empty collection.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A bound that can’t be sampled traps, the way an out-of-range "},{"type":"codeVoice","code":"Array"},{"type":"text","text":" subscript does. To get an"},{"type":"text","text":" "},{"type":"text","text":"error instead, use the "},{"type":"codeVoice","code":"checked"},{"type":"text","text":" spellings: "},{"type":"codeVoice","code":"integer(checkedIn:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"uniform(checkedIn:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"bernoulli(checked:)"},{"type":"text","text":" all throw. Their errors, "},{"type":"codeVoice","code":"EmptyRange"},{"type":"text","text":", "},{"type":"codeVoice","code":"InvalidInterval"},{"type":"text","text":" and "},{"type":"codeVoice","code":"InvalidProbability"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"are top-level types. If another module you import declares one with the same name, qualify ours"},{"type":"text","text":" "},{"type":"text","text":"by its module: "},{"type":"codeVoice","code":"Sampling.EmptyRange"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/PlatformStableDraws","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Uniform values, integers, coin flips, shuffles and picks that a seed fixes on every platform and"},{"type":"text","text":" "},{"type":"text","text":"Swift release."}],"sections":[],"references":{"doc://SwiftPRNG/documentation/SwiftPRNG":{"kind":"symbol","type":"topic","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG","title":"SwiftPRNG","url":"\/documentation\/swiftprng","abstract":[{"type":"text","text":"Seeded random numbers whose seeds you can find, write down and hand to someone else."}],"role":"collection"},"doc://SwiftPRNG/documentation/SwiftPRNG/SeededGenerators":{"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SeededGenerators","kind":"article","type":"topic","title":"Seeded generators","url":"\/documentation\/swiftprng\/seededgenerators","abstract":[{"text":"Generators that are values, driving the standard library’s randomness API.","type":"text"}],"role":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG/UsingSeedTrees":{"kind":"article","type":"topic","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/UsingSeedTrees","title":"Using seed trees","url":"\/documentation\/swiftprng\/usingseedtrees","abstract":[{"type":"text","text":"A seed for every decision, derived from a path, so adding a draw in one place never moves the"},{"type":"text","text":" "},{"type":"text","text":"numbers in another."}],"role":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG/NonOverlappingStreams":{"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/NonOverlappingStreams","kind":"article","type":"topic","title":"Streams that never overlap","url":"\/documentation\/swiftprng\/nonoverlappingstreams","abstract":[{"text":"One seed, many independent streams: one per thread or one per entity.","type":"text"}],"role":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG/SearchingSeedsAcrossCores":{"kind":"article","type":"topic","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SearchingSeedsAcrossCores","title":"Searching seeds across cores","url":"\/documentation\/swiftprng\/searchingseedsacrosscores","abstract":[{"text":"The smallest seed a predicate accepts, found the same way on one core or many.","type":"text"}],"role":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG/SamplingDistributions":{"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SamplingDistributions","kind":"article","type":"topic","title":"Sampling distributions","url":"\/documentation\/swiftprng\/samplingdistributions","abstract":[{"type":"text","text":"Normal, exponential, triangular, log-normal, gamma, Poisson, geometric and weighted-choice samples"},{"type":"text","text":" "},{"type":"text","text":"that match bit for bit on every platform."}],"role":"article"}}}