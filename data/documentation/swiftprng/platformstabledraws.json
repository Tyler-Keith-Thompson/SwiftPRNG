empty collection"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"shuffled(_:)"},{"type":"text","text":" copies any sequence into an array and shuffles it, and "},{"type":"codeVoice","code":"shuffle(_:)"},{"type":"text","text":" shuffles a"},{"type":"text","text":" "},{"type":"text","text":"mutable random-access collection in place, such as an array or a slice of one. Both use"},{"type":"text","text":" "},{"type":"text","text":"Fisher-Yates and take one integer draw per element after the first, so an empty or one-element"},{"type":"text","text":" "},{"type":"text","text":"collection takes none. "},{"type":"codeVoice","code":"element(in:)"},{"type":"text","text":" takes one integer draw, or none for an empty collection."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A bound that can’t be sampled traps, the way an out-of-range "},{"type":"codeVoice","code":"Array"},{"type":"text","text":" subscript does. To get an"},{"type":"text","text":" "},{"type":"text","text":"error instead, use the "},{"type":"codeVoice","code":"checked"},{"type":"text","text":" spellings: "},{"type":"codeVoice","code":"integer(checkedIn:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"uniform(checkedIn:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"bernoulli(checked:)"},{"type":"text","text":" all throw."}],"type":"paragraph"}]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/PlatformStableDraws"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftprng\/platformstabledraws"]}],"references":{"doc://SwiftPRNG/documentation/SwiftPRNG/UsingSeedTrees":{"role":"article","type":"topic","url":"\/documentation\/swiftprng\/usingseedtrees","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/UsingSeedTrees","kind":"article","title":"Using seed trees","abstract":[{"type":"text","text":"A seed for every decision, derived from a path, so adding a draw in one place never moves the"},{"type":"text","text":" "},{"type":"text","text":"numbers in another."}]},"doc://SwiftPRNG/documentation/SwiftPRNG/SamplingDistributions":{"type":"topic","abstract":[{"text":"Normal, exponential, triangular, log-normal, gamma, Poisson, geometric and weighted-choice samples","type":"text"},{"text":" ","type":"text"},{"text":"that match bit for bit on every platform.","type":"text"}],"title":"Sampling distributions","kind":"article","url":"\/documentation\/swiftprng\/samplingdistributions","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SamplingDistributions","role":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG/NonOverlappingStreams":{"type":"topic","abstract":[{"text":"One seed, many independent streams: one per thread or one per entity.","type":"text"}],"title":"Streams that never overlap","kind":"article","url":"\/documentation\/swiftprng\/nonoverlappingstreams","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/NonOverlappingStreams","role":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG":{"type":"topic","abstract":[{"text":"Seeded random numbers whose seeds you can find, write down and hand to someone else.","type":"text"}],"title":"SwiftPRNG","kind":"symbol","url":"\/documentation\/swiftprng","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG","role":"collection"},"doc://SwiftPRNG/documentation/SwiftPRNG/SeededGenerators":{"role":"article","type":"topic","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SeededGenerators","url":"\/documentation\/swiftprng\/seededgenerators","kind":"article","title":"Seeded generators","abstract":[{"text":"Generators that are values, driving the standard library’s randomness API.","type":"text"}]},"doc://SwiftPRNG/documentation/SwiftPRNG/SearchingSeedsAcrossCores":{"type":"topic","abstract":[{"text":"The smallest seed a predicate accepts, found the same way on one core or many.","type":"text"}],"title":"Se