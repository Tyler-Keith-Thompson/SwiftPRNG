{"kind":"article","schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"modules":[{"name":"SwiftPRNG"}],"role":"article","roleHeading":"Article","title":"Using seed trees"},"seeAlsoSections":[{"anchor":"Guides","generated":true,"title":"Guides","identifiers":["doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SeededGenerators","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/PlatformStableDraws","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SamplingDistributions","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/NonOverlappingStreams","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SearchingSeedsAcrossCores"]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"SeedTree"},{"type":"text","text":" derives each node’s seed from its parent’s seed and a key, which is a name or an"},{"type":"text","text":" "},{"type":"text","text":"index. Each decision draws from its own node. Customer 7 arrives at the same time whether or not"},{"type":"text","text":" "},{"type":"text","text":"you add customer 6, and whether or not the code before it draws one more number."}],"type":"paragraph"},{"syntax":"swift","code":["let tree = SeedTree(42)","let arrival = tree[\"customer\", 7, \"arrival\"].uniform(in: 0 ..< 60)","var choices = tree[\"customer\", 7, \"choices\"].generator","let aisle = choices.integer(in: 0 ..< 12)","let arrivals = (0 ..< 3).map { customer in tree[\"customer\", customer, \"arrival\"].uniform(in: 0 ..< 60) }"],"type":"codeListing"},{"inlineContent":[{"text":"Keys can be literals or ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" values.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A node’s "},{"type":"codeVoice","code":"description"},{"type":"text","text":" gives its path and seed, as in "},{"type":"codeVoice","code":"\/customer\/7 (seed 1271…)"},{"type":"text","text":". Print it when a"},{"type":"text","text":" "},{"type":"text","text":"test fails."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To change one part of a tree, override a node: everything under it derives from the new seed,"},{"type":"text","text":" "},{"type":"text","text":"and its siblings keep theirs. "},{"code":"fitting","type":"codeVoice"},{"type":"text","text":" searches for the override that makes a predicate true."},{"type":"text","text":" "},{"type":"text","text":"The overview of "},{"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG","type":"reference","isActive":true},{"type":"text","text":" has an example."}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/UsingSeedTrees","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG"]]},"abstract":[{"type":"text","text":"A seed for every decision, derived from a path, so adding a draw in one place never moves the"},{"type":"text","text":" "},{"type":"text","text":"numbers in another."}],"variants":[{"paths":["\/documentation\/swiftprng\/usingseedtrees"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"references":{"doc://SwiftPRNG/documentation/SwiftPRNG/SamplingDistributions":{"kind":"article","title":"Sampling distributions","role":"article","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SamplingDistributions","abstract":[{"type":"text","text":"Normal, exponential, triangular, log-normal, gamma, Poisson, geometric and weighted-choice samples"},{"type":"text","text":" "},{"type":"text","text":"that match bit for bit on every platform."}],"type":"topic","url":"\/documentation\/swiftprng\/samplingdistributions"},"doc://SwiftPRNG/documentation/SwiftPRNG/SearchingSeedsAcrossCores":{"role":"article","url":"\/documentation\/swiftprng\/searchingseedsacrosscores","type":"topic","title":"Searching seeds across cores","abstract":[{"text":"The smallest seed a predicate accepts, found the same way on one core or many.","type":"text"}],"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SearchingSeedsAcrossCores","kind":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG/SeededGenerators":{"role":"article","url":"\/documentation\/swiftprng\/seededgenerators","title":"Seeded generators","type":"topic","abstract":[{"text":"Generators that are values, driving the standard library’s randomness API.","type":"text"}],"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SeededGenerators","kind":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG/PlatformStableDraws":{"kind":"article","title":"Platform-stable draws","role":"article","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/PlatformStableDraws","abstract":[{"text":"Uniform values, integers and coin flips that a seed fixes on every platform and Swift release.","type":"text"}],"type":"topic","url":"\/documentation\/swiftprng\/platformstabledraws"},"doc://SwiftPRNG/documentation/SwiftPRNG/NonOverlappingStreams":{"role":"article","type":"topic","url":"\/documentation\/swiftprng\/nonoverlappingstreams","title":"Streams that never overlap","abstract":[{"type":"text","text":"One seed, many independent streams: one per thread or one per entity."}],"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/NonOverlappingStreams","kind":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG":{"kind":"symbol","title":"SwiftPRNG","role":"collection","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG","abstract":[{"type":"text","text":"Seeded random numbers whose seeds you can find, write down and hand to someone else."}],"type":"topic","url":"\/documentation\/swiftprng"}}}