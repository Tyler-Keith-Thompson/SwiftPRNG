{"sections":[],"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftprng\/usingseedtrees"]}],"metadata":{"title":"Using seed trees","roleHeading":"Article","role":"article","modules":[{"name":"SwiftPRNG"}]},"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/UsingSeedTrees"},"seeAlsoSections":[{"anchor":"Guides","title":"Guides","identifiers":["doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SeededGenerators","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/PlatformStableDraws","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SamplingDistributions","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/NonOverlappingStreams","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SearchingSeedsAcrossCores"],"generated":true}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"SeedTree"},{"type":"text","text":" derives each node’s seed from its parent’s seed and a key, which is a name or an"},{"type":"text","text":" "},{"type":"text","text":"index. Each decision draws from its own node. Customer 7 arrives at the same time whether or not"},{"type":"text","text":" "},{"type":"text","text":"you add customer 6, and whether or not the code before it draws one more number."}]},{"type":"codeListing","code":["let tree = SeedTree(42)","let arrival = tree[\"customer\", 7, \"arrival\"].uniform(in: 0 ..< 60)","var choices = tree[\"customer\", 7, \"choices\"].generator","let aisle = choices.integer(in: 0 ..< 12)","let arrivals = (0 ..< 3).map { customer in tree[\"customer\", customer, \"arrival\"].uniform(in: 0 ..< 60) }"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Keys can be literals or "},{"type":"codeVoice","code":"String"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" values."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A node’s "},{"type":"codeVoice","code":"description"},{"type":"text","text":" gives its path and seed, as in "},{"type":"codeVoice","code":"\/customer\/7 (seed 1271…)"},{"type":"text","text":". Print it when a"},{"type":"text","text":" "},{"type":"text","text":"test fails."}]},{"type":"paragraph","inlineContent":[{"text":"To change one part of a tree, override a node: everything under it derives from the new seed,","type":"text"},{"text":" ","type":"text"},{"text":"and its siblings keep theirs. ","type":"text"},{"code":"fitting","type":"codeVoice"},{"text":" searches for the override that makes a predicate true.","type":"text"},{"text":" ","type":"text"},{"text":"The overview of ","type":"text"},{"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG","type":"reference","isActive":true},{"text":" has an example.","type":"text"}]}]}],"abstract":[{"text":"A seed for every decision, derived from a path, so adding a draw in one place never moves the","type":"text"},{"text":" ","type":"text"},{"text":"numbers in another.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG"]]},"references":{"doc://SwiftPRNG/documentation/SwiftPRNG/SearchingSeedsAcrossCores":{"title":"Searching seeds across cores","abstract":[{"text":"The smallest seed a predicate accepts, found the same way on one core or many.","type":"text"}],"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SearchingSeedsAcrossCores","url":"\/documentation\/swiftprng\/searchingseedsacrosscores","kind":"article","type":"topic","role":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG/SamplingDistributions":{"title":"Sampling distributions","kind":"article","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SamplingDistributions","url":"\/documentation\/swiftprng\/samplingdistributions","abstract":[{"type":"text","text":"Normal, exponential, triangular, log-normal, gamma, Poisson, geometric and weighted-choice samples"},{"type":"text","text":" "},{"type":"text","text":"that match bit for bit on every platform."}],"type":"topic","role":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG/SeededGenerators":{"title":"Seeded generators","abstract":[{"type":"text","text":"Generators that are values, driving the standard library’s randomness API."}],"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SeededGenerators","url":"\/documentation\/swiftprng\/seededgenerators","kind":"article","type":"topic","role":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG/NonOverlappingStreams":{"title":"Streams that never overlap","kind":"article","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/NonOverlappingStreams","url":"\/documentation\/swiftprng\/nonoverlappingstreams","abstract":[{"text":"One seed, many independent streams: one per thread or one per entity.","type":"text"}],"type":"topic","role":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG/PlatformStableDraws":{"title":"Platform-stable draws","abstract":[{"text":"Uniform values, integers, coin flips, shuffles and picks that a seed fixes on every platform and","type":"text"},{"text":" ","type":"text"},{"text":"Swift release.","type":"text"}],"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/PlatformStableDraws","url":"\/documentation\/swiftprng\/platformstabledraws","kind":"article","type":"topic","role":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG":{"title":"SwiftPRNG","kind":"symbol","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG","url":"\/documentation\/swiftprng","abstract":[{"type":"text","text":"Seeded random numbers whose seeds you can find, write down and hand to someone else."}],"type":"topic","role":"collection"}}}