{"abstract":[{"text":"A seed for every decision, derived from a path, so adding a draw in one place never moves the","type":"text"},{"text":" ","type":"text"},{"text":"numbers in another.","type":"text"}],"sections":[],"kind":"article","variants":[{"paths":["\/documentation\/swiftprng\/usingseedtrees"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"article","roleHeading":"Article","title":"Using seed trees","modules":[{"name":"SwiftPRNG"}]},"schemaVersion":{"minor":3,"patch":0,"major":0},"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SeededGenerators","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/PlatformStableDraws","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SamplingDistributions","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/NonOverlappingStreams","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SearchingSeedsAcrossCores"],"generated":true,"title":"Guides","anchor":"Guides"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"A ","type":"text"},{"code":"SeedTree","type":"codeVoice"},{"text":" derives each node’s seed from its parent’s seed and a key, which is a name or an","type":"text"},{"text":" ","type":"text"},{"text":"index. Each decision draws from its own node. Customer 7 arrives at the same time whether or not","type":"text"},{"text":" ","type":"text"},{"text":"you add customer 6, and whether or not the code before it draws one more number.","type":"text"}],"type":"paragraph"},{"code":["let tree = SeedTree(42)","let arrival = tree[\"customer\", 7, \"arrival\"].uniform(in: 0 ..< 60)","var choices = tree[\"customer\", 7, \"choices\"].generator","let aisle = choices.integer(in: 0 ..< 12)","let arrivals = (0 ..< 3).map { customer in tree[\"customer\", customer, \"arrival\"].uniform(in: 0 ..< 60) }"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Keys can be literals or ","type":"text"},{"type":"codeVoice","code":"String"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Int"},{"text":" values.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A node’s ","type":"text"},{"code":"description","type":"codeVoice"},{"text":" gives its path and seed, as in ","type":"text"},{"code":"\/customer\/7 (seed 1271…)","type":"codeVoice"},{"text":". Print it when a","type":"text"},{"text":" ","type":"text"},{"text":"test fails.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To change one part of a tree, override a node: everything under it derives from the new seed,"},{"type":"text","text":" "},{"type":"text","text":"and its siblings keep theirs. "},{"type":"codeVoice","code":"fitting"},{"type":"text","text":" searches for the override that makes a predicate true."},{"type":"text","text":" "},{"type":"text","text":"The overview of "},{"type":"reference","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG","isActive":true},{"type":"text","text":" has an example."}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/UsingSeedTrees","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG"]]},"references":{"doc://SwiftPRNG/documentation/SwiftPRNG/SearchingSeedsAcrossCores":{"title":"Searching seeds across cores","kind":"article","type":"topic","role":"article","abstract":[{"type":"text","text":"The smallest seed a predicate accepts, found the same way on one core or many."}],"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SearchingSeedsAcrossCores","url":"\/documentation\/swiftprng\/searchingseedsacrosscores"},"doc://SwiftPRNG/documentation/SwiftPRNG/NonOverlappingStreams":{"url":"\/documentation\/swiftprng\/nonoverlappingstreams","title":"Streams that never overlap","kind":"article","abstract":[{"text":"One seed, many independent streams: one per thread or one per entity.","type":"text"}],"identifier":"doc:\/\/SwiftPRNG\/documen