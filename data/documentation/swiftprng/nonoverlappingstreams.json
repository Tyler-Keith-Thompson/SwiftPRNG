{"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"title":"Streams that never overlap","roleHeading":"Article","role":"article","modules":[{"name":"SwiftPRNG"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftprng\/nonoverlappingstreams"]}],"kind":"article","abstract":[{"text":"One seed, many independent streams: one per thread or one per entity.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG"]]},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"jump()"},{"type":"text","text":" moves a generator 2¹²⁸ steps ahead, so the numbers it gives afterwards never repeat the"},{"type":"text","text":" "},{"type":"text","text":"ones it would have given before. Copy the generator, jump it, and repeat: each copy is a stream of"},{"type":"text","text":" "},{"type":"text","text":"its own, and a thread or entity can draw from its copy without coordinating with the others."}],"type":"paragraph"},{"syntax":"swift","code":["var generator = Xoshiro256StarStar(seed: 42)","var streams: [Xoshiro256StarStar] = []","for _ in 0 ..< 4 {","    streams.append(generator)","    generator.jump()  \/\/ 2¹²⁸ steps on","}"],"type":"codeListing"}]}],"identifier":{"url":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/NonOverlappingStreams","interfaceLanguage":"swift"},"seeAlsoSections":[{"generated":true,"title":"Guides","anchor":"Guides","identifiers":["doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SeededGenerators","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/PlatformStableDraws","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SamplingDistributions","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/UsingSeedTrees","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SearchingSeedsAcrossCores"]}],"references":{"doc://SwiftPRNG/documentation/SwiftPRNG":{"kind":"symbol","type":"topic","identifier":"doc:\