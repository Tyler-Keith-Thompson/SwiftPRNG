{"kind":"article","metadata":{"roleHeading":"Article","title":"Streams that never overlap","role":"article","modules":[{"name":"SwiftPRNG"}]},"schemaVersion":{"minor":3,"patch":0,"major":0},"seeAlsoSections":[{"anchor":"Guides","generated":true,"title":"Guides","identifiers":["doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SeededGenerators","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/PlatformStableDraws","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SamplingDistributions","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/UsingSeedTrees","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SearchingSeedsAcrossCores"]}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"codeVoice","code":"jump()"},{"type":"text","text":" moves a generator 2¹²⁸ steps ahead, so the numbers it gives afterwards never repeat the"},{"type":"text","text":" "},{"type":"text","text":"ones it would have given before. Copy the generator, jump it, and repeat: each copy is a stream of"},{"type":"text","text":" "},{"type":"text","text":"its own, and a thread or entity can draw from its copy without coordinating with the others."}],"type":"paragraph"},{"code":["var generator = Xoshiro256StarStar(seed: 42)","var streams: [Xoshiro256StarStar] = []","for _ in 0 ..< 4 {","    streams.append(generator)","    generator.jump()  \/\/ 2¹²⁸ steps on","}"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/NonOverlappingStreams"},"hierarchy":{"paths":[["doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG"]]},"abstract":[{"type":"text","text":"One seed, many independent streams: one per thread or one per entity."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftprng\/nonoverlappingstreams"]}],"sections":[],"references":{"doc://SwiftPRNG/documentation/SwiftPRNG/SeededGenerators":{"role":"article","url":"\/documen