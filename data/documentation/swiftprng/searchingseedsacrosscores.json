{"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"The smallest seed a predicate accepts, found the same way on one core or many.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"code":"SeedSearch","type":"codeVoice"},{"text":" returns the smallest seed that matches, so running the same search again finds the","type":"text"},{"text":" ","type":"text"},{"text":"same seed. ","type":"text"},{"code":"concurrent()","type":"codeVoice"},{"text":" splits the search across every processor and still finds that seed.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let seed = await SeedSearch(0 ..< 10_000_000).concurrent().first { seed in","    var generator = Xoshiro256StarStar(seed: seed)","    return generator.uniform() > 0.999_99","}"],"type":"codeListing"},{"inlineContent":[{"code":"count(where:)","type":"codeVoice"},{"type":"text","text":" tells you how many seeds in a range match. That shows how rare a property is, and"},{"type":"text","text":" "},{"type":"text","text":"so how wide a range you need to search for it."}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SearchingSeedsAcrossCores","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftprng\/searchingseedsacrosscores"]}],"hierarchy":{"paths":[["doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG"]]},"kind":"article","seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SeededGenerators","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/PlatformStableDraws","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SamplingDistributions","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/NonOverlappingStreams","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/UsingSeedTrees"],"anchor":"Guides","title":"Guides"}],"metadata":{"roleHeading":"Article","role":"arti