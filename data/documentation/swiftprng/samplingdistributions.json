{"seeAlsoSections":[{"generated":true,"anchor":"Guides","title":"Guides","identifiers":["doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SeededGenerators","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/PlatformStableDraws","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/NonOverlappingStreams","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/UsingSeedTrees","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SearchingSeedsAcrossCores"]}],"metadata":{"roleHeading":"Article","title":"Sampling distributions","modules":[{"name":"SwiftPRNG"}],"role":"article"},"abstract":[{"type":"text","text":"Normal, exponential, triangular, log-normal, gamma, Poisson, geometric and weighted-choice samples"},{"type":"text","text":" "},{"type":"text","text":"that match bit for bit on every platform."}],"hierarchy":{"paths":[["doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"article","primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each distribution fixes its algorithm and how many draws it takes. Its logarithms and cosines come"},{"type":"text","text":" "},{"type":"text","text":"from a port of fdlibm, so a sample has the same bits on every platform. The port’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"Fdlibm.log"},{"type":"text","text":", "},{"type":"codeVoice","code":"Fdlibm.log1p"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Fdlibm.exp"},{"type":"text","text":" are public, so your own seeded code can use them too."}]},{"type":"codeListing","syntax":"swift","code":["var generator = Xoshiro256StarStar(seed: 42)","let height = NormalDistribution(mean: 170, standardDeviation: 8).sample(using: &generator)","let items = PoissonDistribution(mean: 3).sample(using: &generator)","let aisle = WeightedChoiceDistribution([","    (value: \"produce\", weight: 5), (value: \"bakery\", weight: 2), (value: \"deli\", weight: 1),","]).sample(using: &generator)","","let service = SeedTree(42)[\"customer\", 7, \"service\"].sample(.gamma(shape: 2, scale: 1.5))"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A distribution is a value that holds its parameters, so you can store, compare and share it."},{"type":"text","text":" "},{"type":"text","text":"Invalid parameters trap. "},{"code":"init(checkedMean:standardDeviation:)","type":"codeVoice"},{"type":"text","text":" and the other "},{"code":"checked","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"initializers throw "},{"code":"InvalidParameters","type":"codeVoice"},{"type":"text","text":" instead."}]},{"type":"heading","level":3,"anchor":"Your-own-distributions","text":"Your own distributions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You add a distribution by writing an extension. "},{"type":"codeVoice","code":"map"},{"type":"text","text":" turns one distribution into another without"},{"type":"text","text":" "},{"type":"text","text":"drawing any extra numbers."}]},{"type":"codeListing","syntax":"swift","code":["extension Distribution where Self == MappedDistribution<ExponentialDistribution, Duration> {","    \/\/\/ Waiting times with this mean.","    static func exponential(mean: Duration) -> Self {","        let (seconds, attoseconds) = mean.components","        return ExponentialDistribution(mean: Double(seconds) + Double(attoseconds) * 1e-18).map { .seconds($0) }","    }","}","","let wait = SeedTree(42)[\"customer\", 7, \"wait\"].sample(.exponential(mean: .seconds(90)))"]}]}],"sections":[],"identifier":{"url":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SamplingDistributions","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/swiftprng\/samplingdistributions"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SwiftPRNG/documentation/SwiftPRNG/UsingSeedTrees":{"role":"article","type":"topic","url":"\/documentation\/swiftprng\/us