{"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG"]]},"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Each distribution fixes its algorithm and how many draws it takes. Its logarithms and cosines come","type":"text"},{"text":" ","type":"text"},{"text":"from a port of fdlibm, so a sample has the same bits on every platform. The port’s","type":"text"},{"text":" ","type":"text"},{"code":"Fdlibm.log","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Fdlibm.log1p","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Fdlibm.exp","type":"codeVoice"},{"text":" are public, so your own seeded code can use them too.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var generator = Xoshiro256StarStar(seed: 42)","let height = NormalDistribution(mean: 170, standardDeviation: 8).sample(using: &generator)","let items = PoissonDistribution(mean: 3).sample(using: &generator)","let aisle = WeightedChoiceDistribution([","    (value: \"produce\", weight: 5), (value: \"bakery\", weight: 2), (value: \"deli\", weight: 1),","]).sample(using: &generator)","","let service = SeedTree(42)[\"customer\", 7, \"service\"].sample(.gamma(shape: 2, scale: 1.5))"]},{"type":"paragraph","inlineContent":[{"text":"A distribution is a value that holds its parameters, so you can store, compare and share it.","type":"text"},{"text":" ","type":"text"},{"text":"Invalid parameters trap. ","type":"text"},{"code":"init(checkedMean:standardDeviation:)","type":"codeVoice"},{"text":" and the other ","type":"text"},{"code":"checked","type":"codeVoice"},{"text":" ","type":"text"},{"text":"initializers throw ","type":"text"},{"code":"InvalidParameters","type":"codeVoice"},{"text":" instead.","type":"text"}]},{"text":"Your own distributions","type":"heading","level":3,"anchor":"Your-own-distributions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You add a distribution by writing an extension. "},{"code":"map","type":"codeVoice"},{"type":"text","text":" turns one distribution into another without"},{"type":"text","text":" "},{"type":"text","text":"drawing any extra numbers."}]},{"type":"codeListing","syntax":"swift","code":["extension Distribution where Self == MappedDistribution<ExponentialDistribution, Duration> {","    \/\/\/ Waiting times with this mean.","    static func exponential(mean: Duration) -> Self {","        let (seconds, attoseconds) = mean.components","        return ExponentialDistribution(mean: Double(seconds) + Double(attoseconds) * 1e-18).map { .seconds($0) }","    }","}","","let wait = SeedTree(42)[\"customer\", 7, \"wait\"].sample(.exponential(mean: .seconds(90)))"]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swiftprng\/samplingdistributions"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Normal, exponential, triangular, log-normal, gamma, Poisson, geometric and weighted-choice samples","type":"text"},{"text":" ","type":"text"},{"text":"that match bit for bit on every platform.","type":"text"}],"metadata":{"modules":[{"name":"SwiftPRNG"}],"title":"Sampling distributions","role":"article","roleHeading":"Article"},"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SamplingDistributions"},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SeededGenerators","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/PlatformStableDraws","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/NonOverlappingStreams","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/UsingSeedTrees","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SearchingSeedsAcrossCores"],"anchor":"Guides","title":"Guides"}],"kind":"article","references":{"doc://SwiftPRNG/documentation/SwiftPRNG/SeededGenerators":{"url":"\/documentation\/swiftprng\/seededgenerators","type":"topic","role":"article","abstract":[{"type":"text","text":"Generators that are values, driving the standard library’s randomness API."}],"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SeededGenerators","title":"Seeded generators","kind":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG/NonOverlappingStreams":{"url":"\/documentation\/swiftprng\/nonoverlappingstreams","type":"topic","role":"article","abstract":[{"text":"One seed, many independent streams: one per thread or one per entity.","type":"text"}],"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/NonOverlappingStreams","title":"Streams that never overlap","kind":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG":{"url":"\/documentation\/swiftprng","type":"topic","role":"collection","abstract":[{"type":"text","text":"Seeded random numbers whose seeds you can find, write down and hand to someone else."}],"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG","title":"SwiftPRNG","kind":"symbol"},"doc://SwiftPRNG/documentation/SwiftPRNG/PlatformStableDraws":{"role":"article","title":"Platform-stable draws","url":"\/documentation\/swiftprng\/platformstabledraws","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/PlatformStableDraws","kind":"article","abstract":[{"type":"text","text":"Uniform values, integers, coin flips, shuffles and picks that a seed fixes on every platform and"},{"type":"text","text":" "},{"type":"text","text":"Swift release."}],"type":"topic"},"doc://SwiftPRNG/documentation/SwiftPRNG/UsingSeedTrees":{"role":"article","title":"Using seed trees","url":"\/documentation\/swiftprng\/usingseedtrees","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/UsingSeedTrees","kind":"article","abstract":[{"type":"text","text":"A seed for every decision, derived from a path, so adding a draw in one place never moves the"},{"type":"text","text":" "},{"type":"text","text":"numbers in another."}],"type":"topic"},"doc://SwiftPRNG/documentation/SwiftPRNG/SearchingSeedsAcrossCores":{"role":"article","title":"Searching seeds across cores","url":"\/documentation\/swiftprng\/searchingseedsacrosscores","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SearchingSeedsAcrossCores","kind":"article","abstract":[{"type":"text","text":"The smallest seed a predicate accepts, found the same way on one core or many."}],"type":"topic"}}}