{"sections":[],"kind":"article","variants":[{"paths":["\/documentation\/swiftprng\/samplingdistributions"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"SwiftPRNG"}],"roleHeading":"Article","title":"Sampling distributions","role":"article"},"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SamplingDistributions","interfaceLanguage":"swift"},"seeAlsoSections":[{"generated":true,"title":"Guides","anchor":"Guides","identifiers":["doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SeededGenerators","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/PlatformStableDraws","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/NonOverlappingStreams","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/UsingSeedTrees","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SearchingSeedsAcrossCores"]}],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each distribution fixes its algorithm and how many draws it takes. Its logarithms and cosines come"},{"type":"text","text":" "},{"type":"text","text":"from a port of fdlibm, so a sample has the same bits on every platform. The port’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"Fdlibm.log"},{"type":"text","text":", "},{"type":"codeVoice","code":"Fdlibm.log1p"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Fdlibm.exp"},{"type":"text","text":" are public, so your own seeded code can use them too."}]},{"code":["var generator = Xoshiro256StarStar(seed: 42)","let height = NormalDistribution(mean: 170, standardDeviation: 8).sample(using: &generator)","let items = PoissonDistribution(mean: 3).sample(using: &generator)","let aisle = WeightedChoiceDistribution([","    (value: \"produce\", weight: 5), (value: \"bakery\", weight: 2), (value: \"deli\", weight: 1),","]).sample(using: &generator)","","let service = SeedTree(42)[\"customer\", 7, \"service\"].sample(.gamma(shape: 2, scale: 1.5))"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A distribution is a value that holds its parameters, so you can store, compare and share it.","type":"text"},{"text":" ","type":"text"},{"text":"Invalid parameters trap. ","type":"text"},{"type":"codeVoice","code":"init(checkedMean:standardDeviation:)"},{"text":" and the other ","type":"text"},{"type":"codeVoice","code":"checked"},{"text":" ","type":"text"},{"text":"initializers throw ","type":"text"},{"type":"codeVoice","code":"InvalidParameters"},{"text":" instead.","type":"text"}]},{"text":"Your own distributions","anchor":"Your-own-distributions","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You add a distribution by writing an extension. "},{"type":"codeVoice","code":"map"},{"type":"text","text":" turns one distribution into another without"},{"type":"text","text":" "},{"type":"text","text":"drawing any extra numbers."}]},{"code":["extension Distribution where Self == MappedDistribution<ExponentialDistribution, Duration> {","    \/\/\/ Waiting times with this mean.","    static func exponential(mean: Duration) -> Self {","        let (seconds, attoseconds) = mean.components","        return ExponentialDistribution(mean: Double(seconds) + Double(attoseconds) * 1e-18).map { .seconds($0) }","    }","}","","let wait = SeedTree(42)[\"customer\", 7, \"wait\"].sample(.exponential(mean: .seconds(90)))"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"abstract":[{"type":"text","text":"Normal, exponential, triangular, log-normal, gamma, Poisson, geometric and weighted-choice samples"},{"type":"text","text":" "},{"type":"text","text":"that match bit for bit on every platform."}],"hierarchy":{"paths":[["doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG"]]},"references":{"doc://SwiftPRNG/documentation/SwiftPRNG/SearchingSeedsAcrossCores":{"title":"Searching seeds across cores","abstract":[{"text":"The smallest seed a predicate accepts, found the same way on one core or many.","type":"text"}],"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SearchingSeedsAcrossCores","url":"\/documentation\/swiftprng\/searchingseedsacrosscores","kind":"article","type":"topic","role":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG/SeededGenerators":{"title":"Seeded generators","abstract":[{"type":"text","text":"Generators that are values, driving the standard library’s randomness API."}],"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SeededGenerators","url":"\/documentation\/swiftprng\/seededgenerators","kind":"article","type":"topic","role":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG/NonOverlappingStreams":{"title":"Streams that never overlap","kind":"article","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/NonOverlappingStreams","url":"\/documentation\/swiftprng\/nonoverlappingstreams","abstract":[{"text":"One seed, many independent streams: one per thread or one per entity.","type":"text"}],"type":"topic","role":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG/UsingSeedTrees":{"title":"Using seed trees","kind":"article","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/UsingSeedTrees","url":"\/documentation\/swiftprng\/usingseedtrees","abstract":[{"type":"text","text":"A seed for every decision, derived from a path, so adding a draw in one place never moves the"},{"type":"text","text":" "},{"type":"text","text":"numbers in another."}],"type":"topic","role":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG/PlatformStableDraws":{"title":"Platform-stable draws","abstract":[{"text":"Uniform values, integers, coin flips, shuffles and picks that a seed fixes on every platform and","type":"text"},{"text":" ","type":"text"},{"text":"Swift release.","type":"text"}],"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/PlatformStableDraws","url":"\/documentation\/swiftprng\/platformstabledraws","kind":"article","type":"topic","role":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG":{"title":"SwiftPRNG","kind":"symbol","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG","url":"\/documentation\/swiftprng","abstract":[{"type":"text","text":"Seeded random numbers whose seeds you can find, write down and hand to someone else."}],"type":"topic","role":"collection"}}}