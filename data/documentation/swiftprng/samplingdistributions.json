{"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"SwiftPRNG"}],"title":"Sampling distributions"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftprng\/samplingdistributions"]}],"kind":"article","abstract":[{"type":"text","text":"Normal, exponential, triangular, log-normal, gamma, Poisson, geometric and weighted-choice samples"},{"type":"text","text":" "},{"type":"text","text":"that match bit for bit on every platform."}],"hierarchy":{"paths":[["doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG"]]},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"text":"Each distribution fixes its algorithm and how many draws it takes. Its logarithms and cosines come","type":"text"},{"text":" ","type":"text"},{"text":"from a port of fdlibm, so a sample has the same bits on every platform. The port’s","type":"text"},{"text":" ","type":"text"},{"code":"Fdlibm.log","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Fdlibm.log1p","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Fdlibm.exp","type":"codeVoice"},{"text":" are public, so your own seeded code can use them too.","type":"text"}],"type":"paragraph"},{"code":["var generator = Xoshiro256StarStar(seed: 42)","let height = NormalDistribution(mean: 170, standardDeviation: 8).sample(using: &generator)","let items = PoissonDistribution(mean: 3).sample(using: &generator)","let aisle = WeightedChoiceDistribution([","    (value: \"produce\", weight: 5), (value: \"bakery\", weight: 2), (value: \"deli\", weight: 1),","]).sample(using: &generator)","","let service = SeedTree(42)[\"customer\", 7, \"service\"].sample(.gamma(shape: 2, scale: 1.5))"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"A distribution is a value that holds its parameters, so you can store, compare and share it.","type":"text"},{"text":" ","type":"text"},{"text":"Invalid parameters trap. ","type":"text"},{"type":"codeVoice","code":"init(checkedMean:standardDeviation:)"},{"text":" and the other ","type":"text"},{"type":"codeVoice","code":"checked"},{"text":" ","type":"text"},{"text":"initializers throw ","type":"text"},{"type":"codeVoice","code":"InvalidParameters"},{"text":" instead.","type":"text"}],"type":"paragraph"},{"text":"Your own distributions","anchor":"Your-own-distributions","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"You add a distribution by writing an extension. "},{"type":"codeVoice","code":"map"},{"type":"text","text":" turns one distribution into another without"},{"type":"text","text":" "},{"type":"text","text":"drawing any extra numbers."}],"type":"paragraph"},{"code":["extension Distribution where Self == MappedDistribution<ExponentialDistribution, Duration> {","    \/\/\/ Waiting times with this mean.","    static func exponential(mean: Duration) -> Self {","        let (seconds, attoseconds) = mean.components","        return ExponentialDistribution(mean: Double(seconds) + Double(attoseconds) * 1e-18).map { .seconds($0) }","    }","}","","let wait = SeedTree(42)[\"customer\", 7, \"wait\"].sample(.exponential(mean: .seconds(90)))"],"type":"codeListing","syntax":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SamplingDistributions"},"seeAlsoSections":[{"generated":true,"anchor":"Guides","title":"Guides","identifiers":["doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SeededGenerators","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/PlatformStableDraws","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/NonOverlappingStreams","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/UsingSeedTrees","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SearchingSeedsAcrossCores"]}],"references":{"doc://SwiftPRNG/documentation/SwiftPRNG/UsingSeedTrees":{"kind":"article","type":"topic","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/UsingSeedTrees","title":"Using seed trees","url":"\/documentation\/swiftprng\/usingseedtrees","abstract":[{"type":"text","text":"A seed for every decision, derived from a path, so adding a draw in one place never moves the"},{"type":"text","text":" "},{"type":"text","text":"numbers in another."}],"role":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG/SeededGenerators":{"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SeededGenerators","kind":"article","type":"topic","title":"Seeded generators","url":"\/documentation\/swiftprng\/seededgenerators","abstract":[{"text":"Generators that are values, driving the standard library’s randomness API.","type":"text"}],"role":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG/PlatformStableDraws":{"kind":"article","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/PlatformStableDraws","type":"topic","title":"Platform-stable draws","url":"\/documentation\/swiftprng\/platformstabledraws","abstract":[{"type":"text","text":"Uniform values, integers, coin flips, shuffles and picks that a seed fixes on every platform and"},{"type":"text","text":" "},{"type":"text","text":"Swift release."}],"role":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG/NonOverlappingStreams":{"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/NonOverlappingStreams","kind":"article","type":"topic","title":"Streams that never overlap","url":"\/documentation\/swiftprng\/nonoverlappingstreams","abstract":[{"text":"One seed, many independent streams: one per thread or one per entity.","type":"text"}],"role":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG/SearchingSeedsAcrossCores":{"kind":"article","type":"topic","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SearchingSeedsAcrossCores","title":"Searching seeds across cores","url":"\/documentation\/swiftprng\/searchingseedsacrosscores","abstract":[{"text":"The smallest seed a predicate accepts, found the same way on one core or many.","type":"text"}],"role":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG":{"kind":"symbol","type":"topic","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG","title":"SwiftPRNG","url":"\/documentation\/swiftprng","abstract":[{"type":"text","text":"Seeded random numbers whose seeds you can find, write down and hand to someone else."}],"role":"collection"}}}