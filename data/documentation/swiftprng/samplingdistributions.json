{"hierarchy":{"paths":[["doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG"]]},"abstract":[{"text":"Normal, exponential, triangular, log-normal, gamma, Poisson, geometric and weighted-choice samples","type":"text"},{"text":" ","type":"text"},{"text":"that match bit for bit on every platform.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Each distribution fixes its algorithm and how many draws it takes. Its logarithms and cosines come","type":"text"},{"text":" ","type":"text"},{"text":"from a port of fdlibm, so a sample has the same bits on every platform. The port’s","type":"text"},{"text":" ","type":"text"},{"code":"Fdlibm.log","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Fdlibm.log1p","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Fdlibm.exp","type":"codeVoice"},{"text":" are public, so your own seeded code can use them too.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["var generator = Xoshiro256StarStar(seed: 42)","let height = NormalDistribution(mean: 170, standardDeviation: 8).sample(using: &generator)","let items = PoissonDistribution(mean: 3).sample(using: &generator)","let aisle = WeightedChoiceDistribution([","    (value: \"produce\", weight: 5), (value: \"bakery\", weight: 2), (value: \"deli\", weight: 1),","]).sample(using: &generator)","","let service = SeedTree(42)[\"customer\", 7, \"service\"].sample(.gamma(shape: 2, scale: 1.5))"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A distribution is a value that holds its parameters, so you can store, compare and share it."},{"type":"text","text":" "},{"type":"text","text":"Invalid parameters trap. "},{"code":"init(checkedMean:standardDeviation:)","type":"codeVoice"},{"type":"text","text":" and the other "},{"code":"checked","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"initializers throw "},{"code":"InvalidParameters","type":"codeVoice"},{"type":"text","text":" instead."}]},{"level":3,"type":"heading","text":"Your own distributions","anchor":"Your-own-distributions"},{"type":"paragraph","inlineContent":[{"text":"You add a distribution by writing an extension. ","type":"text"},{"code":"map","type":"codeVoice"},{"text":" turns one distribution into another without","type":"text"},{"text":" ","type":"text"},{"text":"drawing any extra numbers.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["extension Distribution where Self == MappedDistribution<ExponentialDistribution, Duration> {","    \/\/\/ Waiting times with this mean.","    static func exponential(mean: Duration) -> Self {","        let (seconds, attoseconds) = mean.components","        return ExponentialDistribution(mean: Double(seconds) + Double(attoseconds) * 1e-18).map { .seconds($0) }","    }","}","","let wait = SeedTree(42)[\"customer\", 7, \"wait\"].sample(.exponential(mean: .seconds(90)))"]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftprng\/samplingdistributions"]}],"identifier":{"url":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SamplingDistributions","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"SwiftPRNG"}],"role":"article","title":"Sampling distributions","roleHeading":"Article"},"sections":[],"seeAlsoSections":[{"generated":true,"anchor":"Guides","identifiers":["doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SeededGenerators","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/PlatformStableDraws","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/NonOverlappingStreams","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/UsingSeedTrees","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SearchingSeedsAcrossCores"],"title":"Guides"}],"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://SwiftPRNG/documentation/SwiftPRNG/UsingSeedTrees":{"kind":"article","title":"Using seed trees","role":"article","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/UsingSeedTrees","abstract":[{"text":"A seed for every decision, derived from a path, so adding a draw in one place never moves the","type":"text"},{"text":" ","type":"text"},{"text":"numbers in another.","type":"text"}],"type":"topic","url":"\/documentation\/swiftprng\/usingseedtrees"},"doc://SwiftPRNG/documentation/SwiftPRNG/PlatformStableDraws":{"kind":"article","title":"Platform-stable draws","role":"article","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/PlatformStableDraws","abstract":[{"text":"Uniform values, integers and coin flips that a seed fixes on every platform and Swift release.","type":"text"}],"type":"topic","url":"\/documentation\/swiftprng\/platformstabledraws"},"doc://SwiftPRNG/documentation/SwiftPRNG/SearchingSeedsAcrossCores":{"role":"article","url":"\/documentation\/swiftprng\/searchingseedsacrosscores","type":"topic","title":"Searching seeds across cores","abstract":[{"text":"The smallest seed a predicate accepts, found the same way on one core or many.","type":"text"}],"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SearchingSeedsAcrossCores","kind":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG/SeededGenerators":{"role":"article","url":"\/documentation\/swiftprng\/seededgenerators","title":"Seeded generators","type":"topic","abstract":[{"text":"Generators that are values, driving the standard library’s randomness API.","type":"text"}],"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SeededGenerators","kind":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG/NonOverlappingStreams":{"role":"article","type":"topic","url":"\/documentation\/swiftprng\/nonoverlappingstreams","title":"Streams that never overlap","abstract":[{"type":"text","text":"One seed, many independent streams: one per thread or one per entity."}],"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/NonOverlappingStreams","kind":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG":{"