{"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"mentions":["doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/UsingSeedTrees"],"kind":"mentions"},{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"text":"Every type is a value. The generators (","type":"text"},{"isActive":true,"identifier":"doc:\/\/Generators\/documentation\/Generators","type":"reference"},{"text":") reproduce bit for bit on every platform","type":"text"},{"text":" ","type":"text"},{"text":"and in every Swift release, and are ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":", so a position in a","type":"text"},{"text":" ","type":"text"},{"text":"sequence can be copied, compared, saved and restored. The draws (","type":"text"},{"isActive":true,"identifier":"doc:\/\/Sampling\/documentation\/Sampling","type":"reference"},{"text":") fix their","type":"text"},{"text":" ","type":"text"},{"text":"algorithms, where the standard library’s ","type":"text"},{"code":"random(in:using:)","type":"codeVoice"},{"text":" promises only a correct distribution.","type":"text"},{"text":" ","type":"text"},{"text":"The distributions (","type":"text"},{"isActive":true,"identifier":"doc:\/\/Distributions\/documentation\/Distributions","type":"reference"},{"text":") do the same for normal, exponential, gamma, Poisson and","type":"text"},{"text":" ","type":"text"},{"text":"the rest, down to their logarithms and cosines. A seed tree (","type":"text"},{"isActive":true,"identifier":"doc:\/\/SeedTrees\/documentation\/SeedTrees","type":"reference"},{"text":") gives each decision in a program a seed of its own, derived from a","type":"text"},{"text":" ","type":"text"},{"text":"path of names and indices, so adding a draw anywhere never shifts the numbers elsewhere. A seed","type":"text"},{"text":" ","type":"text"},{"text":"search (","type":"text"},{"isActive":true,"identifier":"doc:\/\/SeedDiscovery\/documentation\/SeedDiscovery","type":"reference"},{"text":") finds the smallest seed in a range that does what a predicate asks,","type":"text"},{"text":" ","type":"text"},{"text":"sequentially or across cores, and a tree fits that seed into one subtree while the rest of the","type":"text"},{"text":" ","type":"text"},{"text":"program stays as it was.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Bounds that cannot be sampled trap, like an ","type":"text"},{"type":"codeVoice","code":"Array"},{"text":" subscript; the ","type":"text"},{"type":"codeVoice","code":"checked"},{"text":" spellings throw a","type":"text"},{"text":" ","type":"text"},{"text":"typed error instead.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"import SwiftPRNG"},{"type":"text","text":" imports every module. Each module also has its own documentation and can be"},{"type":"text","text":" "},{"type":"text","text":"imported on its own."}],"type":"paragraph"},{"code":["import SwiftPRNG","","let tree = SeedTree(42)","let fitted = tree.fitting([\"customer\", 7], in: SeedSearch(0 ..< 100_000)) { tree in","    tree[\"customer\", 7, \"arrival\"].uniform(in: 0 ..< 60) < 1","}","let overrides = fitted?.overriddenSeeds  \/\/ [[\"customer\", 7]: 33]"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swiftprng"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"SwiftPRNG"}],"role":"collection","title":"SwiftPRNG","roleHeading":"Framework","externalID":"SwiftPRNG","symbolKind":"module"},"sections":[],"hierarchy":{"paths":[[]]},"identifier":{"url":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Seeded random numbers whose seeds you can find, write down and hand to someone else."}],"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SeededGenerators","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/PlatformStableDraws","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SamplingDistributions","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/NonOverlappingStreams","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/UsingSeedTrees","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SearchingSeedsAcrossCores"],"title":"Guides","anchor":"Guides"},{"identifiers":["doc:\/\/Generators\/documentation\/Generators","doc:\/\/Sampling\/documentation\/Sampling","doc:\/\/Distributions\/documentation\/Distributions","doc:\/\/SeedDiscovery\/documentation\/SeedDiscovery","doc:\/\/SeedTrees\/documentation\/SeedTrees"],"title":"Modules","anchor":"Modules"}],"references":{"doc://SwiftPRNG/documentation/SwiftPRNG/PlatformStableDraws":{"kind":"article","title":"Platform-stable draws","role":"article","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/PlatformStableDraws","abstract":[{"text":"Uniform values, integers and coin flips that a seed fixes on every platform and Swift release.","type":"text"}],"type":"topic","url":"\/documentation\/swiftprng\/platformstabledraws"},"doc://SwiftPRNG/documentation/SwiftPRNG/NonOverlappingStreams":{"role":"article","type":"topic","url":"\/documentation\/swiftprng\/nonoverlappingstreams","title":"Streams that never overlap","abstract":[{"type":"text","text":"One seed, many independent streams: one per thread or one per entity."}],"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/NonOverlappingStreams","kind":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG":{"kind":"symbol","title":"SwiftPRNG","role":"collection","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG","abstract":[{"type":"text","text":"Seeded random numbers whose seeds you can find, write down and hand to someone else."}],"type":"topic","url":"\/documentation\/swiftprng"},"doc://SwiftPRNG/documentation/SwiftPRNG/SearchingSeedsAcrossCores":{"role":"article","url":"\/documentation\/swiftprng\/searchingseedsacrosscores","type":"topic","title":"Searching seeds across cores","abstract":[{"text":"The smallest seed a predicate accepts, found the same way on one core or many.","type":"text"}],"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SearchingSeedsAcrossCores","kind":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG/UsingSeedTrees":{"kind":"article","title":"Using seed trees","role":"article","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/UsingSeedTrees","abstract":[{"text":"A seed for every decision, derived from a path, so adding a draw in one place never moves the","type":"text"},{"text":" ","type":"text"},{"text":"numbers in another.","type":"text"}],"type":"topic","url":"\/documentation\/swiftprng\/usingseedtrees"},"doc://SwiftPRNG/documentation/SwiftPRNG/SeededGenerators":{"role":"article","url":"\/documentation\/swiftprng\/seededgenerators","title":"Seeded generators","type":"topic","abstract":[{"text":"Generators that are values, driving the standard library’s randomness API.","type":"text"}],"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SeededGenerators","kind":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG/SamplingDistributions":{"kind":"article","title":"Sampling distributions","role":"article","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SamplingDistributions","abstract":[{"type":"text","text":"Normal, exponential, triangular, log-normal, gamma, Poisson, geometric and weighted-choice samples"},{"type":"text","text":" "},{"type":"text","text":"that match bit for bit on every platform."}],"type":"topic","url":"\/documentation\/swiftprng\/samplingdistributions"},"doc://SeedTrees/documentation/SeedTrees":{"kind":"symbol","title":"SeedTrees","role":"collection","identifier":"doc:\/\/SeedTrees\/documentation\/SeedTrees","abstract":[],"type":"topic","url":"\/documentation\/seedtrees"},"doc://SeedDiscovery/documentation/SeedDiscovery":{"abstract":[],"url":"\/documentation\/seeddiscovery","type":"topic","role":"collection","identifier":"doc:\/\/SeedDiscovery\/documentation\/SeedDiscovery","title":"SeedDiscovery","kind":"symbol"},"doc://Sampling/documentation/Sampling":{"kind":"symbol","title":"Sampling","role":"collection","identifier":"doc:\/\/Sampling\/documentation\/Sampling","abstract":[],"type":"topic","url":"\/documentation\/sampling"},"doc://Distributions/documentation/Distributions":{"abstract":[],"url":"\/documentation\/distributions","type":"topic","role":"collection","identifier":"doc:\/\/Distributions\/documentation\/Distributions","title":"Distributions","kind":"symbol"},"doc://Generators/documentation/Generators":{"kind":"symbol","title":"Generators","role":"collection","identifier":"doc:\/\/Generators\/documentation\/Generators","abstract":[],"type":"topic","url":"\/documentation\/generators"}}}