{"variants":[{"paths":["\/documentation\/swiftprng"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG","interfaceLanguage":"swift"},"kind":"symbol","topicSections":[{"title":"Guides","identifiers":["doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SeededGenerators","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/PlatformStableDraws","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SamplingDistributions","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/NonOverlappingStreams","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/UsingSeedTrees","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SearchingSeedsAcrossCores"],"anchor":"Guides"},{"title":"Modules","identifiers":["doc:\/\/Generators\/documentation\/Generators","doc:\/\/Sampling\/documentation\/Sampling","doc:\/\/Distributions\/documentation\/Distributions","doc:\/\/SeedDiscovery\/documentation\/SeedDiscovery","doc:\/\/SeedTrees\/documentation\/SeedTrees"],"anchor":"Modules"}],"metadata":{"symbolKind":"module","modules":[{"name":"SwiftPRNG"}],"roleHeading":"Framework","title":"SwiftPRNG","role":"collection","externalID":"SwiftPRNG"},"primaryContentSections":[{"mentions":["doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/UsingSeedTrees"],"kind":"mentions"},{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"Every type is a value. The generators ("},{"type":"reference","identifier":"doc:\/\/Generators\/documentation\/Generators","isActive":true},{"type":"text","text":") reproduce bit for bit on every platform"},{"type":"text","text":" "},{"type":"text","text":"and in every Swift release, and are "},{"code":"Hashable","type":"codeVoice"},{"type":"text","text":", "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":", so a position in a"},{"type":"text","text":" "},{"type":"text","text":"sequence can be copied, compared, saved and restored. The draws ("},{"type":"reference","identifier":"doc:\/\/Sampling\/documentation\/Sampling","isActive":true},{"type":"text","text":") fix their"},{"type":"text","text":" "},{"type":"text","text":"algorithms, where the standard library’s "},{"code":"random(in:using:)","type":"codeVoice"},{"type":"text","text":" promises only a correct distribution."},{"type":"text","text":" "},{"type":"text","text":"The distributions ("},{"type":"reference","identifier":"doc:\/\/Distributions\/documentation\/Distributions","isActive":true},{"type":"text","text":") do the same for normal, exponential, gamma, Poisson and"},{"type":"text","text":" "},{"type":"text","text":"the rest, down to their logarithms and cosines. A seed tree ("},{"type":"reference","identifier":"doc:\/\/SeedTrees\/documentation\/SeedTrees","isActive":true},{"type":"text","text":") gives each decision in a program a seed of its own, derived from a"},{"type":"text","text":" "},{"type":"text","text":"path of names and indices, so adding a draw anywhere never shifts the numbers elsewhere. A seed"},{"type":"text","text":" "},{"type":"text","text":"search ("},{"type":"reference","identifier":"doc:\/\/SeedDiscovery\/documentation\/SeedDiscovery","isActive":true},{"type":"text","text":") finds the smallest seed in a range that does what a predicate asks,"},{"type":"text","text":" "},{"type":"text","text":"sequentially or across cores, and a tree fits that seed into one subtree while the rest of the"},{"type":"text","text":" "},{"type":"text","text":"program stays as it was."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Bounds that cannot be sampled trap, like an "},{"type":"codeVoice","code":"Array"},{"type":"text","text":" subscript; the "},{"type":"codeVoice","code":"checked"},{"type":"text","text":" spellings throw a"},{"type":"text","text":" "},{"type":"text","text":"typed error instead."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"import SwiftPRNG"},{"type":"text","text":" imports every module. Each module also has its own documentation and can be"},{"type":"text","text":" "},{"type":"text","text":"imported on its own."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import SwiftPRNG","","let tree = SeedTree(42)","let fitted = tree.fitting([\"customer\", 7], in: SeedSearch(0 ..< 100_000)) { tree in","    tree[\"customer\", 7, \"arrival\"].uniform(in: 0 ..< 60) < 1","}","let overrides = fitted?.overriddenSeeds  \/\/ [[\"customer\", 7]: 33]"]}],"kind":"content"}],"sections":[],"hierarchy":{"paths":[[]]},"abstract":[{"text":"Seeded random numbers whose seeds you can find, write down and hand to someone else.","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://SwiftPRNG/documentation/SwiftPRNG/PlatformStableDraws":{"kind":"article","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/PlatformStableDraws","type":"topic","title":"Platform-stable draws","url":"\/documentation\/swiftprng\/platformstabledraws","abstract":[{"type":"text","text":"Uniform values, integers, coin flips, shuffles and picks that a seed fixes on every platform and"},{"type":"text","text":" "},{"type":"text","text":"Swift release."}],"role":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG/SamplingDistributions":{"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SamplingDistributions","kind":"article","type":"topic","title":"Sampling distributions","url":"\/documentation\/swiftprng\/samplingdistributions","abstract":[{"type":"text","text":"Normal, exponential, triangular, log-normal, gamma, Poisson, geometric and weighted-choice samples"},{"type":"text","text":" "},{"type":"text","text":"that match bit for bit on every platform."}],"role":"article"},"doc://SeedDiscovery/documentation/SeedDiscovery":{"title":"SeedDiscovery","role":"collection","kind":"symbol","abstract":[],"type":"topic","identifier":"doc:\/\/SeedDiscovery\/documentation\/SeedDiscovery","url":"\/documentation\/seeddiscovery"},"doc://SeedTrees/documentation/SeedTrees":{"kind":"symbol","identifier":"doc:\/\/SeedTrees\/documentation\/SeedTrees","type":"topic","title":"SeedTrees","url":"\/documentation\/seedtrees","abstract":[],"role":"collection"},"doc://Generators/documentation/Generators":{"title":"Generators","role":"collection","kind":"symbol","abstract":[],"type":"topic","identifier":"doc:\/\/Generators\/documentation\/Generators","url":"\/documentation\/generators"},"doc://SwiftPRNG/documentation/SwiftPRNG":{"kind":"symbol","type":"topic","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG","title":"SwiftPRNG","url":"\/documentation\/swiftprng","abstract":[{"type":"text","text":"Seeded random numbers whose seeds you can find, write down and hand to someone else."}],"role":"collection"},"doc://SwiftPRNG/documentation/SwiftPRNG/SeededGenerators":{"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SeededGenerators","kind":"article","type":"topic","title":"Seeded generators","url":"\/documentation\/swiftprng\/seededgenerators","abstract":[{"text":"Generators that are values, driving the standard library’s randomness API.","type":"text"}],"role":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG/SearchingSeedsAcrossCores":{"kind":"article","type":"topic","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SearchingSeedsAcrossCores","title":"Searching seeds across cores","url":"\/documentation\/swiftprng\/searchingseedsacrosscores","abstract":[{"text":"The smallest seed a predicate accepts, found the same way on one core or many.","type":"text"}],"role":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG/UsingSeedTrees":{"kind":"article","type":"topic","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/UsingSeedTrees","title":"Using seed trees","url":"\/documentation\/swiftprng\/usingseedtrees","abstract":[{"type":"text","text":"A seed for every decision, derived from a path, so adding a draw in one place never moves the"},{"type":"text","text":" "},{"type":"text","text":"numbers in another."}],"role":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG/NonOverlappingStreams":{"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/NonOverlappingStreams","kind":"article","type":"topic","title":"Streams that never overlap","url":"\/documentation\/swiftprng\/nonoverlappingstreams","abstract":[{"text":"One seed, many independent streams: one per thread or one per entity.","type":"text"}],"role":"article"},"doc://Distributions/documentation/Distributions":{"kind":"symbol","identifier":"doc:\/\/Distributions\/documentation\/Distributions","type":"topic","title":"Distributions","url":"\/documentation\/distributions","abstract":[],"role":"collection"},"doc://Sampling/documentation/Sampling":{"title":"Sampling","role":"collection","kind":"symbol","abstract":[],"type":"topic","identifier":"doc:\/\/Sampling\/documentation\/Sampling","url":"\/documentation\/sampling"}}}