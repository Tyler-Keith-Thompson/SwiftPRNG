{"hierarchy":{"paths":[[]]},"sections":[],"primaryContentSections":[{"kind":"mentions","mentions":["doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/UsingSeedTrees"]},{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Every type is a value. The generators (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Generators\/documentation\/Generators"},{"text":") reproduce bit for bit on every platform","type":"text"},{"text":" ","type":"text"},{"text":"and in every Swift release, and are ","type":"text"},{"type":"codeVoice","code":"Hashable"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":", so a position in a","type":"text"},{"text":" ","type":"text"},{"text":"sequence can be copied, compared, saved and restored. The draws (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Sampling\/documentation\/Sampling"},{"text":") fix their","type":"text"},{"text":" ","type":"text"},{"text":"algorithms, where the standard library’s ","type":"text"},{"type":"codeVoice","code":"random(in:using:)"},{"text":" promises only a correct distribution.","type":"text"},{"text":" ","type":"text"},{"text":"The distributions (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Distributions\/documentation\/Distributions"},{"text":") do the same for normal, exponential, gamma, Poisson and","type":"text"},{"text":" ","type":"text"},{"text":"the rest, down to their logarithms and cosines. A seed tree (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SeedTrees\/documentation\/SeedTrees"},{"text":") gives each decision in a program a seed of its own, derived from a","type":"text"},{"text":" ","type":"text"},{"text":"path of names and indices, so adding a draw anywhere never shifts the numbers elsewhere. A seed","type":"text"},{"text":" ","type":"text"},{"text":"search (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SeedDiscovery\/documentation\/SeedDiscovery"},{"text":") finds the smallest seed in a range that does what a predicate asks,","type":"text"},{"text":" ","type":"text"},{"text":"sequentially or across cores, and a tree fits that seed into one subtree while the rest of the","type":"text"},{"text":" ","type":"text"},{"text":"program stays as it was.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Bounds that cannot be sampled trap, like an ","type":"text"},{"type":"codeVoice","code":"Array"},{"text":" subscript; the ","type":"text"},{"type":"codeVoice","code":"checked"},{"text":" spellings throw a","type":"text"},{"text":" ","type":"text"},{"text":"typed error instead.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"import SwiftPRNG"},{"type":"text","text":" imports every module. Each module also has its own documentation and can be"},{"type":"text","text":" "},{"type":"text","text":"imported on its own."}]},{"code":["import SwiftPRNG","","let tree = SeedTree(42)","let fitted = tree.fitting([\"customer\", 7], in: SeedSearch(0 ..< 100_000)) { tree in","    tree[\"customer\", 7, \"arrival\"].uniform(in: 0 ..< 60) < 1","}","let overrides = fitted?.overriddenSeeds  \/\/ [[\"customer\", 7]: 33]"],"type":"codeListing","syntax":"swift"}]}],"variants":[{"paths":["\/documentation\/swiftprng"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Seeded random numbers whose seeds you can find, write down and hand to someone else."}],"metadata":{"title":"SwiftPRNG","externalID":"SwiftPRNG","role":"collection","modules":[{"name":"SwiftPRNG"}],"symbolKind":"module","roleHeading":"Framework"},"schemaVersion":{"major":0,"patch":0,"minor":3},"topicSections":[{"title":"Guides","anchor":"Guides","identifiers":["doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SeededGenerators","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/PlatformStableDraws","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SamplingDistributions","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/NonOverlappingStreams","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/UsingSeedTrees","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SearchingSeedsAcrossCores"]},{"title":"Modules","anchor":"Modules","identifiers":["doc:\/\/Generators\/documentation\/Generators","doc:\/\/Sampling\/documentation\/Sampling","doc:\/\/Distributions\/documentation\/Distributions","doc:\/\/SeedDiscovery\/documentation\/SeedDiscovery","doc:\/\/SeedTrees\/documentation\/SeedTrees"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG"},"kind":"symbol","references":{"doc://SwiftPRNG/documentation/SwiftPRNG/PlatformStableDraws":{"role":"article","title":"Platform-stable draws","url":"\/documentation\/swiftprng\/platformstabledraws","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/PlatformStableDraws","kind":"article","abstract":[{"type":"text","text":"Uniform values, integers, coin flips, shuffles and picks that a seed fixes on every platform and"},{"type":"text","text":" "},{"type":"text","text":"Swift release."}],"type":"topic"},"doc://SeedTrees/documentation/SeedTrees":{"title":"SeedTrees","url":"\/documentation\/seedtrees","abstract":[],"kind":"symbol","identifier":"doc:\/\/SeedTrees\/documentation\/SeedTrees","type":"topic","role":"collection"},"doc://Sampling/documentation/Sampling":{"url":"\/documentation\/sampling","type":"topic","role":"collection","abstract":[],"identifier":"doc:\/\/Sampling\/documentation\/Sampling","title":"Sampling","kind":"symbol"},"doc://Generators/documentation/Generators":{"title":"Generators","url":"\/documentation\/generators","abstract":[],"kind":"symbol","identifier":"doc:\/\/Generators\/documentation\/Generators","type":"topic","role":"collection"},"doc://SwiftPRNG/documentation/SwiftPRNG/NonOverlappingStreams":{"url":"\/documentation\/swiftprng\/nonoverlappingstreams","type":"topic","role":"article","abstract":[{"text":"One seed, many independent streams: one per thread or one per entity.","type":"text"}],"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/NonOverlappingStreams","title":"Streams that never overlap","kind":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG/SeededGenerators":{"url":"\/documentation\/swiftprng\/seededgenerators","type":"topic","role":"article","abstract":[{"type":"text","text":"Generators that are values, driving the standard library’s randomness API."}],"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SeededGenerators","title":"Seeded generators","kind":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG":{"url":"\/documentation\/swiftprng","type":"topic","role":"collection","abstract":[{"type":"text","text":"Seeded random numbers whose seeds you can find, write down and hand to someone else."}],"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG","title":"SwiftPRNG","kind":"symbol"},"doc://SwiftPRNG/documentation/SwiftPRNG/UsingSeedTrees":{"role":"article","title":"Using seed trees","url":"\/documentation\/swiftprng\/usingseedtrees","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/UsingSeedTrees","kind":"article","abstract":[{"type":"text","text":"A seed for every decision, derived from a path, so adding a draw in one place never moves the"},{"type":"text","text":" "},{"type":"text","text":"numbers in another."}],"type":"topic"},"doc://SwiftPRNG/documentation/SwiftPRNG/SearchingSeedsAcrossCores":{"role":"article","title":"Searching seeds across cores","url":"\/documentation\/swiftprng\/searchingseedsacrosscores","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SearchingSeedsAcrossCores","kind":"article","abstract":[{"type":"text","text":"The smallest seed a predicate accepts, found the same way on one core or many."}],"type":"topic"},"doc://SwiftPRNG/documentation/SwiftPRNG/SamplingDistributions":{"url":"\/documentation\/swiftprng\/samplingdistributions","type":"topic","role":"article","abstract":[{"type":"text","text":"Normal, exponential, triangular, log-normal, gamma, Poisson, geometric and weighted-choice samples"},{"type":"text","text":" "},{"type":"text","text":"that match bit for bit on every platform."}],"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SamplingDistributions","title":"Sampling distributions","kind":"article"},"doc://SeedDiscovery/documentation/SeedDiscovery":{"url":"\/documentation\/seeddiscovery","type":"topic","role":"collection","abstract":[],"identifier":"doc:\/\/SeedDiscovery\/documentation\/SeedDiscovery","title":"SeedDiscovery","kind":"symbol"},"doc://Distributions/documentation/Distributions":{"title":"Distributions","url":"\/documentation\/distributions","abstract":[],"kind":"symbol","identifier":"doc:\/\/Distributions\/documentation\/Distributions","type":"topic","role":"collection"}}}