{"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"type":"text","text":"Seeded random numbers whose seeds you can find, write down and hand to someone else."}],"topicSections":[{"anchor":"Guides","title":"Guides","identifiers":["doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SeededGenerators","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/PlatformStableDraws","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SamplingDistributions","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/NonOverlappingStreams","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/UsingSeedTrees","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SearchingSeedsAcrossCores"]},{"anchor":"Modules","title":"Modules","identifiers":["doc:\/\/Generators\/documentation\/Generators","doc:\/\/Sampling\/documentation\/Sampling","doc:\/\/Distributions\/documentation\/Distributions","doc:\/\/SeedDiscovery\/documentation\/SeedDiscovery","doc:\/\/SeedTrees\/documentation\/SeedTrees"]}],"primaryContentSections":[{"mentions":["doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/UsingSeedTrees"],"kind":"mentions"},{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"Every type is a value. The generators ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/Generators\/documentation\/Generators"},{"type":"text","text":") reproduce bit for bit on every platform"},{"type":"text","text":" "},{"type":"text","text":"and in every Swift release, and are "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":", "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":", so a position in a"},{"type":"text","text":" "},{"type":"text","text":"sequence can be copied, compared, saved and restored. The draws ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/Sampling\/documentation\/Sampling"},{"type":"text","text":") fix their"},{"type":"text","text":" "},{"type":"text","text":"algorithms, where the standard library’s "},{"type":"codeVoice","code":"random(in:using:)"},{"type":"text","text":" promises only a correct distribution."},{"type":"text","text":" "},{"type":"text","text":"The distributions ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/Distributions\/documentation\/Distributions"},{"type":"text","text":") do the same for normal, exponential, gamma, Poisson and"},{"type":"text","text":" "},{"type":"text","text":"the rest, down to their logarithms and cosines. A seed tree ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/SeedTrees\/documentation\/SeedTrees"},{"type":"text","text":") gives each decision in a program a seed of its own, derived from a"},{"type":"text","text":" "},{"type":"text","text":"path of names and indices, so adding a draw anywhere never shifts the numbers elsewhere. A seed"},{"type":"text","text":" "},{"type":"text","text":"search ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/SeedDiscovery\/documentation\/SeedDiscovery"},{"type":"text","text":") finds the smallest seed in a range that does what a predicate asks,"},{"type":"text","text":" "},{"type":"text","text":"sequentially or across cores, and a tree fits that seed into one subtree while the rest of the"},{"type":"text","text":" "},{"type":"text","text":"program stays as it was."}],"type":"paragraph"},{"inlineContent":[{"text":"Bounds that cannot be sampled trap, like an ","type":"text"},{"code":"Array","type":"codeVoice"},{"text":" subscript; the ","type":"text"},{"code":"checked","type":"codeVoice"},{"text":" spellings throw a","type":"text"},{"text":" ","type":"text"},{"text":"typed error instead.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"import SwiftPRNG","type":"codeVoice"},{"type":"text","text":" imports every module. Each module also has its own documentation and can be"},{"type":"text","text":" "},{"type":"text","text":"imported on its own."}],"type":"paragraph"},{"code":["import SwiftPRNG","","let tree = SeedTree(42)","let fitted = tree.fitting([\"customer\", 7], in: SeedSearch(0 ..< 100_000)) { tree in","    tree[\"customer\", 7, \"arrival\"].uniform(in: 0 ..< 60) < 1","}","let overrides = fitted?.overriddenSeeds  \/\/ [[\"customer\", 7]: 33]"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"identifier":{"url":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/swiftprng"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[[]]},"kind":"symbol","metadata":{"externalID":"SwiftPRNG","roleHeading":"Framework","modules":[{"name":"SwiftPRNG"}],"role":"collection","symbolKind":"module","title":"SwiftPRNG"},"sections":[],"references":{"doc://SwiftPRNG/documentation/SwiftPRNG":{"title":"SwiftPRNG","kind":"symbol","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG","url":"\/documentation\/swiftprng","abstract":[{"type":"text","text":"Seeded random numbers whose seeds you can find, write down and hand to someone else."}],"type":"topic","role":"collection"},"doc://SwiftPRNG/documentation/SwiftPRNG/SearchingSeedsAcrossCores":{"title":"Searching seeds across cores","abstract":[{"text":"The smallest seed a predicate accepts, found the same way on one core or many.","type":"text"}],"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SearchingSeedsAcrossCores","url":"\/documentation\/swiftprng\/searchingseedsacrosscores","kind":"article","type":"topic","role":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG/UsingSeedTrees":{"title":"Using seed trees","kind":"article","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/UsingSeedTrees","url":"\/documentation\/swiftprng\/usingseedtrees","abstract":[{"type":"text","text":"A seed for every decision, derived from a path, so adding a draw in one place never moves the"},{"type":"text","text":" "},{"type":"text","text":"numbers in another."}],"type":"topic","role":"article"},"doc://Sampling/documentation/Sampling":{"title":"Sampling","abstract":[],"identifier":"doc:\/\/Sampling\/documentation\/Sampling","url":"\/documentation\/sampling","kind":"symbol","type":"topic","role":"collection"},"doc://SeedDiscovery/documentation/SeedDiscovery":{"title":"SeedDiscovery","kind":"symbol","identifier":"doc:\/\/SeedDiscovery\/documentation\/SeedDiscovery","url":"\/documentation\/seeddiscovery","abstract":[],"type":"topic","role":"collection"},"doc://Distributions/documentation/Distributions":{"title":"Distributions","abstract":[],"identifier":"doc:\/\/Distributions\/documentation\/Distributions","url":"\/documentation\/distributions","kind":"symbol","type":"topic","role":"collection"},"doc://SwiftPRNG/documentation/SwiftPRNG/NonOverlappingStreams":{"title":"Streams that never overlap","kind":"article","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/NonOverlappingStreams","url":"\/documentation\/swiftprng\/nonoverlappingstreams","abstract":[{"text":"One seed, many independent streams: one per thread or one per entity.","type":"text"}],"type":"topic","role":"article"},"doc://Generators/documentation/Generators":{"title":"Generators","kind":"symbol","identifier":"doc:\/\/Generators\/documentation\/Generators","url":"\/documentation\/generators","abstract":[],"type":"topic","role":"collection"},"doc://SwiftPRNG/documentation/SwiftPRNG/SamplingDistributions":{"title":"Sampling distributions","kind":"article","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SamplingDistributions","url":"\/documentation\/swiftprng\/samplingdistributions","abstract":[{"type":"text","text":"Normal, exponential, triangular, log-normal, gamma, Poisson, geometric and weighted-choice samples"},{"type":"text","text":" "},{"type":"text","text":"that match bit for bit on every platform."}],"type":"topic","role":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG/SeededGenerators":{"title":"Seeded generators","abstract":[{"type":"text","text":"Generators that are values, driving the standard library’s randomness API."}],"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SeededGenerators","url":"\/documentation\/swiftprng\/seededgenerators","kind":"article","type":"topic","role":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG/PlatformStableDraws":{"title":"Platform-stable draws","abstract":[{"text":"Uniform values, integers, coin flips, shuffles and picks that a seed fixes on every platform and","type":"text"},{"text":" ","type":"text"},{"text":"Swift release.","type":"text"}],"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/PlatformStableDraws","url":"\/documentation\/swiftprng\/platformstabledraws","kind":"article","type":"topic","role":"article"},"doc://SeedTrees/documentation/SeedTrees":{"title":"SeedTrees","abstract":[],"identifier":"doc:\/\/SeedTrees\/documentation\/SeedTrees","url":"\/documentation\/seedtrees","kind":"symbol","type":"topic","role":"collection"}}}