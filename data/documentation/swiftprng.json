{"abstract":[{"text":"Seeded random numbers whose seeds you can find, write down and hand to someone else.","type":"text"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG"},"primaryContentSections":[{"kind":"mentions","mentions":["doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/UsingSeedTrees"]},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every type is a value. The generators ("},{"identifier":"doc:\/\/Generators\/documentation\/Generators","type":"reference","isActive":true},{"type":"text","text":") reproduce bit for bit on every platform"},{"type":"text","text":" "},{"type":"text","text":"and in every Swift release, and are "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":", "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":", so a position in a"},{"type":"text","text":" "},{"type":"text","text":"sequence can be copied, compared, saved and restored. The draws ("},{"identifier":"doc:\/\/Sampling\/documentation\/Sampling","type":"reference","isActive":true},{"type":"text","text":") fix their"},{"type":"text","text":" "},{"type":"text","text":"algorithms, where the standard library’s "},{"type":"codeVoice","code":"random(in:using:)"},{"type":"text","text":" promises only a correct distribution."},{"type":"text","text":" "},{"type":"text","text":"The distributions ("},{"identifier":"doc:\/\/Distributions\/documentation\/Distributions","type":"reference","isActive":true},{"type":"text","text":") do the same for normal, exponential, gamma, Poisson and"},{"type":"text","text":" "},{"type":"text","text":"the rest, down to their logarithms and cosines. A seed tree ("},{"identifier":"doc:\/\/SeedTrees\/documentation\/SeedTrees","type":"reference","isActive":true},{"type":"text","text":") gives each decision in a program a seed of its own, derived from a"},{"type":"text","text":" "},{"type":"text","text":"path of names and indices, so adding a draw anywhere never shifts the numbers elsewhere. A seed"},{"type":"text","text":" "},{"type":"text","text":"search ("},{"identifier":"doc:\/\/SeedDiscovery\/documentation\/SeedDiscovery","type":"reference","isActive":true},{"type":"text","text":") finds the smallest seed in a range that does what a predicate asks,"},{"type":"text","text":" "},{"type":"text","text":"sequentially or across cores, and a tree fits that seed into one subtree while the rest of the"},{"type":"text","text":" "},{"type":"text","text":"program stays as it was."}]},{"type":"paragraph","inlineContent":[{"text":"Bounds that cannot be sampled trap, like an ","type":"text"},{"type":"codeVoice","code":"Array"},{"text":" subscript; the ","type":"text"},{"type":"codeVoice","code":"checked"},{"text":" spellings throw a","type":"text"},{"text":" ","type":"text"},{"text":"typed error instead.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"import SwiftPRNG"},{"type":"text","text":" imports every module. Each module also has its own documentation and can be"},{"type":"text","text":" "},{"type":"text","text":"imported on its own."}]},{"type":"codeListing","syntax":"swift","code":["import SwiftPRNG","","let tree = SeedTree(42)","let fitted = tree.fitting([\"customer\", 7], in: SeedSearch(0 ..< 100_000)) { tree in","    tree[\"customer\", 7, \"arrival\"].uniform(in: 0 ..< 60) < 1","}","let overrides = fitted?.overriddenSeeds  \/\/ [[\"customer\", 7]: 33]"]}],"kind":"content"}],"kind":"symbol","metadata":{"modules":[{"name":"SwiftPRNG"}],"role":"collection","title":"SwiftPRNG","roleHeading":"Framework","externalID":"SwiftPRNG","symbolKind":"module"},"topicSections":[{"anchor":"Guides","identifiers":["doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SeededGenerators","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/PlatformStableDraws","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SamplingDistributions","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/NonOverlappingStreams","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/UsingSeedTrees","doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SearchingSeedsAcrossCores"],"title":"Guides"},{"anchor":"Modules","identifiers":["doc:\/\/Generators\/documentation\/Generators","doc:\/\/Sampling\/documentation\/Sampling","doc:\/\/Distributions\/documentation\/Distributions","doc:\/\/SeedDiscovery\/documentation\/SeedDiscovery","doc:\/\/SeedTrees\/documentation\/SeedTrees"],"title":"Modules"}],"sections":[],"hierarchy":{"paths":[[]]},"variants":[{"paths":["\/documentation\/swiftprng"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SwiftPRNG/documentation/SwiftPRNG":{"type":"topic","abstract":[{"text":"Seeded random numbers whose seeds you can find, write down and hand to someone else.","type":"text"}],"title":"SwiftPRNG","kind":"symbol","url":"\/documentation\/swiftprng","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG","role":"collection"},"doc://SeedTrees/documentation/SeedTrees":{"type":"topic","abstract":[],"title":"SeedTrees","kind":"symbol","url":"\/documentation\/seedtrees","identifier":"doc:\/\/SeedTrees\/documentation\/SeedTrees","role":"collection"},"doc://SwiftPRNG/documentation/SwiftPRNG/UsingSeedTrees":{"role":"article","type":"topic","url":"\/documentation\/swiftprng\/usingseedtrees","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/UsingSeedTrees","kind":"article","title":"Using seed trees","abstract":[{"type":"text","text":"A seed for every decision, derived from a path, so adding a draw in one place never moves the"},{"type":"text","text":" "},{"type":"text","text":"numbers in another."}]},"doc://SwiftPRNG/documentation/SwiftPRNG/SamplingDistributions":{"type":"topic","abstract":[{"text":"Normal, exponential, triangular, log-normal, gamma, Poisson, geometric and weighted-choice samples","type":"text"},{"text":" ","type":"text"},{"text":"that match bit for bit on every platform.","type":"text"}],"title":"Sampling distributions","kind":"article","url":"\/documentation\/swiftprng\/samplingdistributions","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SamplingDistributions","role":"article"},"doc://Sampling/documentation/Sampling":{"abstract":[],"identifier":"doc:\/\/Sampling\/documentation\/Sampling","type":"topic","role":"collection","kind":"symbol","title":"Sampling","url":"\/documentation\/sampling"},"doc://SwiftPRNG/documentation/SwiftPRNG/PlatformStableDraws":{"role":"article","type":"topic","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/PlatformStableDraws","url":"\/documentation\/swiftprng\/platformstabledraws","kind":"article","title":"Platform-stable draws","abstract":[{"text":"Uniform values, integers, coin flips, shuffles and picks that a seed fixes on every platform and","type":"text"},{"text":" ","type":"text"},{"text":"Swift release.","type":"text"}]},"doc://SeedDiscovery/documentation/SeedDiscovery":{"type":"topic","abstract":[],"title":"SeedDiscovery","kind":"symbol","url":"\/documentation\/seeddiscovery","identifier":"doc:\/\/SeedDiscovery\/documentation\/SeedDiscovery","role":"collection"},"doc://Distributions/documentation/Distributions":{"abstract":[],"identifier":"doc:\/\/Distributions\/documentation\/Distributions","type":"topic","role":"collection","kind":"symbol","title":"Distributions","url":"\/documentation\/distributions"},"doc://Generators/documentation/Generators":{"type":"topic","abstract":[],"title":"Generators","kind":"symbol","url":"\/documentation\/generators","identifier":"doc:\/\/Generators\/documentation\/Generators","role":"collection"},"doc://SwiftPRNG/documentation/SwiftPRNG/SeededGenerators":{"role":"article","type":"topic","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SeededGenerators","url":"\/documentation\/swiftprng\/seededgenerators","kind":"article","title":"Seeded generators","abstract":[{"text":"Generators that are values, driving the standard library’s randomness API.","type":"text"}]},"doc://SwiftPRNG/documentation/SwiftPRNG/NonOverlappingStreams":{"type":"topic","abstract":[{"text":"One seed, many independent streams: one per thread or one per entity.","type":"text"}],"title":"Streams that never overlap","kind":"article","url":"\/documentation\/swiftprng\/nonoverlappingstreams","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/NonOverlappingStreams","role":"article"},"doc://SwiftPRNG/documentation/SwiftPRNG/SearchingSeedsAcrossCores":{"type":"topic","abstract":[{"text":"The smallest seed a predicate accepts, found the same way on one core or many.","type":"text"}],"title":"Searching seeds across cores","kind":"article","url":"\/documentation\/swiftprng\/searchingseedsacrosscores","identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG\/SearchingSeedsAcrossCores","role":"article"}}}