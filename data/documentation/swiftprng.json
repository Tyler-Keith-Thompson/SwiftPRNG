{"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"text":"Every type is a value. The generators (","type":"text"},{"isActive":true,"identifier":"doc:\/\/Generators\/documentation\/Generators","type":"reference"},{"text":") reproduce bit for bit on every platform","type":"text"},{"text":" ","type":"text"},{"text":"and in every Swift release, and are ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":", so a position in a","type":"text"},{"text":" ","type":"text"},{"text":"sequence can be copied, compared, saved and restored. The draws (","type":"text"},{"isActive":true,"identifier":"doc:\/\/Sampling\/documentation\/Sampling","type":"reference"},{"text":") fix their","type":"text"},{"text":" ","type":"text"},{"text":"algorithms, where the standard library’s ","type":"text"},{"code":"random(in:using:)","type":"codeVoice"},{"text":" promises only a correct distribution.","type":"text"},{"text":" ","type":"text"},{"text":"The distributions (","type":"text"},{"isActive":true,"identifier":"doc:\/\/Distributions\/documentation\/Distributions","type":"reference"},{"text":") do the same for normal, exponential, gamma, Poisson and","type":"text"},{"text":" ","type":"text"},{"text":"the rest, down to their logarithms and cosines. A seed tree (","type":"text"},{"isActive":true,"identifier":"doc:\/\/SeedTrees\/documentation\/SeedTrees","type":"reference"},{"text":") gives each decision in a program a seed of its own, derived from a","type":"text"},{"text":" ","type":"text"},{"text":"path of names and indices, so adding a draw anywhere never shifts the numbers elsewhere. A seed","type":"text"},{"text":" ","type":"text"},{"text":"search (","type":"text"},{"isActive":true,"identifier":"doc:\/\/SeedDiscovery\/documentation\/SeedDiscovery","type":"reference"},{"text":") finds the smallest seed in a range that does what a predicate asks,","type":"text"},{"text":" ","type":"text"},{"text":"sequentially or across cores, and a tree fits that seed into one subtree while the rest of the","type":"text"},{"text":" ","type":"text"},{"text":"program stays as it was.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Bounds that cannot be sampled trap, like an "},{"type":"codeVoice","code":"Array"},{"type":"text","text":" subscript; the "},{"type":"codeVoice","code":"checked"},{"type":"text","text":" spellings throw a"},{"type":"text","text":" "},{"type":"text","text":"typed error instead."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"import SwiftPRNG"},{"type":"text","text":" imports every module. Each module also has its own documentation and can be"},{"type":"text","text":" "},{"type":"text","text":"imported on its own."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import SwiftPRNG","","let tree = SeedTree(42)","let fitted = tree.fitting([\"customer\", 7], in: SeedSearch(0 ..< 100_000)) { tree in","    tree[\"customer\", 7, \"arrival\"].uniform(in: 0 ..< 60) < 1","}","fitted?.overriddenSeeds  \/\/ [[\"customer\", 7]: 33]"]}]}],"identifier":{"url":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG","interfaceLanguage":"swift"},"sections":[],"kind":"symbol","abstract":[{"type":"text","text":"Seeded random numbers whose seeds you can find, write down and hand to someone else."}],"topicSections":[{"identifiers":["doc:\/\/Generators\/documentation\/Generators","doc:\/\/Sampling\/documentation\/Sampling","doc:\/\/Distributions\/documentation\/Distributions","doc:\/\/SeedDiscovery\/documentation\/SeedDiscovery","doc:\/\/SeedTrees\/documentation\/SeedTrees"],"anchor":"Modules","title":"Modules"}],"variants":[{"paths":["\/documentation\/swiftprng"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[[]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"modules":[{"name":"SwiftPRNG"}],"roleHeading":"Framework","role":"collection","title":"SwiftPRNG","externalID":"SwiftPRNG","symbolKind":"module"},"references":{"doc://Distributions/documentation/Distributions":{"url":"\/documentation\/distributions","identifier":"doc:\/\/Distributions\/documentation\/Distributions","type":"topic","role":"collection","abstract":[],"title":"Distributions","kind":"symbol"},"doc://SeedTrees/documentation/SeedTrees":{"type":"topic","identifier":"doc:\/\/SeedTrees\/documentation\/SeedTrees","kind":"symbol","abstract":[],"title":"SeedTrees","url":"\/documentation\/seedtrees","role":"collection"},"doc://SeedDiscovery/documentation/SeedDiscovery":{"url":"\/documentation\/seeddiscovery","identifier":"doc:\/\/SeedDiscovery\/documentation\/SeedDiscovery","type":"topic","role":"collection","abstract":[],"title":"SeedDiscovery","kind":"symbol"},"doc://Sampling/documentation/Sampling":{"type":"topic","identifier":"doc:\/\/Sampling\/documentation\/Sampling","kind":"symbol","abstract":[],"title":"Sampling","url":"\/documentation\/sampling","role":"collection"},"doc://SwiftPRNG/documentation/SwiftPRNG":{"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG","url":"\/documentation\/swiftprng","type":"topic","role":"collection","abstract":[{"text":"Seeded random numbers whose seeds you can find, write down and hand to someone else.","type":"text"}],"title":"SwiftPRNG","kind":"symbol"},"doc://Generators/documentation/Generators":{"type":"topic","identifier":"doc:\/\/Generators\/documentation\/Generators","abstract":[],"kind":"symbol","title":"Generators","url":"\/documentation\/generators","role":"collection"}}}