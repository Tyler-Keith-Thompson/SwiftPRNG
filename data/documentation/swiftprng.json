{"abstract":[{"type":"text","text":"Seeded random numbers whose seeds you can find, write down and hand to someone else."}],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"Every type is a value. The generators (","type":"text"},{"identifier":"doc:\/\/Generators\/documentation\/Generators","isActive":true,"type":"reference"},{"text":") reproduce bit for bit on every platform","type":"text"},{"text":" ","type":"text"},{"text":"and in every Swift release, and are ","type":"text"},{"type":"codeVoice","code":"Hashable"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":", so a position in a","type":"text"},{"text":" ","type":"text"},{"text":"sequence can be copied, compared, saved and restored. The draws (","type":"text"},{"identifier":"doc:\/\/Sampling\/documentation\/Sampling","isActive":true,"type":"reference"},{"text":") fix their","type":"text"},{"text":" ","type":"text"},{"text":"algorithms, where the standard library’s ","type":"text"},{"type":"codeVoice","code":"random(in:using:)"},{"text":" promises only a correct distribution.","type":"text"},{"text":" ","type":"text"},{"text":"A seed tree (","type":"text"},{"identifier":"doc:\/\/SeedTrees\/documentation\/SeedTrees","isActive":true,"type":"reference"},{"text":") gives each decision in a program a seed of its own, derived from a","type":"text"},{"text":" ","type":"text"},{"text":"path of names and indices, so adding a draw anywhere never shifts the numbers elsewhere. A seed","type":"text"},{"text":" ","type":"text"},{"text":"search (","type":"text"},{"identifier":"doc:\/\/SeedDiscovery\/documentation\/SeedDiscovery","isActive":true,"type":"reference"},{"text":") finds the smallest seed in a range that does what a predicate asks,","type":"text"},{"text":" ","type":"text"},{"text":"sequentially or across cores, and a tree fits that seed into one subtree while the rest of the","type":"text"},{"text":" ","type":"text"},{"text":"program stays as it was.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Bounds that cannot be sampled trap, like an "},{"code":"Array","type":"codeVoice"},{"type":"text","text":" subscript; the "},{"code":"checked","type":"codeVoice"},{"type":"text","text":" spellings throw a"},{"type":"text","text":" "},{"type":"text","text":"typed error instead."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"import SwiftPRNG"},{"type":"text","text":" imports every module. Each module also has its own documentation and can be"},{"type":"text","text":" "},{"type":"text","text":"imported on its own."}],"type":"paragraph"},{"code":["import SwiftPRNG","","let tree = SeedTree(42)","let fitted = tree.fitting([\"customer\", 7], in: SeedSearch(0 ..< 100_000)) { tree in","    tree[\"customer\", 7, \"arrival\"].uniform(in: 0 ..< 60) < 1","}","fitted?.overriddenSeeds  \/\/ [[\"customer\", 7]: 33]"],"type":"codeListing","syntax":"swift"}]}],"topicSections":[{"title":"Modules","anchor":"Modules","identifiers":["doc:\/\/Generators\/documentation\/Generators","doc:\/\/Sampling\/documentation\/Sampling","doc:\/\/SeedDiscovery\/documentation\/SeedDiscovery","doc:\/\/SeedTrees\/documentation\/SeedTrees"]}],"metadata":{"modules":[{"name":"SwiftPRNG"}],"symbolKind":"module","externalID":"SwiftPRNG","roleHeading":"Framework","role":"collection","title":"SwiftPRNG"},"sections":[],"hierarchy":{"paths":[[]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftprng"]}],"identifier":{"url":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG","interfaceLanguage":"swift"},"references":{"doc://Sampling/documentation/Sampling":{"kind":"symbol","title":"Sampling","type":"topic","abstract":[],"identifier":"doc:\/\/Sampling\/documentation\/Sampling","role":"collection","url":"\/documentation\/sampling"},"doc://SeedDiscovery/documentation/SeedDiscovery":{"abstract":[],"kind":"symbol","url":"\/documentation\/seeddiscovery","title":"SeedDiscovery","role":"collection","type":"topic","identifier":"doc:\/\/SeedDiscovery\/documentation\/SeedDiscovery"},"doc://SeedTrees/documentation/SeedTrees":{"kind":"symbol","title":"SeedTrees","type":"topic","abstract":[],"identifier":"doc:\/\/SeedTrees\/documentation\/SeedTrees","role":"collection","url":"\/documentation\/seedtrees"},"doc://Generators/documentation/Generators":{"abstract":[],"kind":"symbol","url":"\/documentation\/generators","title":"Generators","role":"collection","type":"topic","identifier":"doc:\/\/Generators\/documentation\/Generators"},"doc://SwiftPRNG/documentation/SwiftPRNG":{"kind":"symbol","title":"SwiftPRNG","type":"topic","abstract":[{"text":"Seeded random numbers whose seeds you can find, write down and hand to someone else.","type":"text"}],"identifier":"doc:\/\/SwiftPRNG\/documentation\/SwiftPRNG","role":"collection","url":"\/documentation\/swiftprng"}}}